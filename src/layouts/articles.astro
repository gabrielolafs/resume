---
import '../styles/articles.css';
import WiiButton from '../components/wii-button.astro';
import FocusedBottomBar from '../components/focused-bottom-bar.astro';

const { frontmatter } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>
  <body>
    <dev class="background">
      <svg xmlns="http://www.w3.org/2000/svg" stroke="currentColor" width="100%" height="100%" preserveAspectRatio="none" viewBox="0 0 24 24">
        <path d="m2,4q-1,8 0,16q0.4,1.6 2,2q8,1 16,0q2,0 2,-2q1,-8 0,-16q0,-2 -2,-2q-8,-1 -16,0q-2,0 -2,2" fill="none" id="svg_1" stroke="black" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </dev>
    <dev class="vignette"></dev>
    <h1>{frontmatter.title}</h1>
    {frontmatter.dateWritten && <p>Written: {frontmatter.dateWritten}</p>}
    {frontmatter.timeSpan && <p>Active: {frontmatter.timeSpan}</p>}

    <br/>
    <article>
      <slot /> 
    </article>
    {frontmatter.dateWritten && <FocusedBottomBar />}
  </body>
</html>