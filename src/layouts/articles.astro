---
import '../styles/articles.css';
import FocusedBottomBar from '../components/focused-bottom-bar.astro';
import WholeScreenScene from '../components/whole-screen-scene.astro';
import { ClientRouter } from 'astro:transitions';

const { frontmatter } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <ClientRouter />

    <!-- safari. something smells stinky. -->
    {(frontmatter.dateWritten) ? <meta name="theme-color" content="#000000"/> : <meta name="theme-color" content="var(--wii-background)"/>}
  </head>
  <body> 
    <WholeScreenScene/>

    {frontmatter.dateWritten && <div class="vignette">
      {/* mobile support sillieness. cant have a cutout - have to do it in a silly way cause otherwise it black screens */}
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="100%" height="100%" preserveAspectRatio="none">
        <filter id="blurMe">
          <feGaussianBlur in="SourceGraphic" stdDeviation=".3" />
        </filter>
        <path filter="url(#blurMe)"
          fill="none" stroke="black" stroke-width="4"
          d="M-1 3 Q-2 25 -1 47 Q-0.9583 50.9583 3 51 Q25 52 47 51 Q50.9583 50.9583 51 47 Q52 25 51 3 Q50.9583 -0.9583 47 -1 Q25 -2 3 -1 Q-0.9583 -0.9583 -1 3 Z"
        />
      </svg>
    </div>}
    <div class="top">
      <div class="title">
        <h1>{frontmatter.title}</h1>
      </div>
      <div class="timeline">
        {frontmatter.dateWritten && <p><b>Written:</b> {frontmatter.dateWritten}</p>}
        {frontmatter.timeSpan && <p><b>Active:</b> {frontmatter.timeSpan}</p>}
      </div>
      <div class="tech-stack">
        {frontmatter.tech && frontmatter.tech.map((tech : String) => (
          <div class="tech">{tech}</div>
        ))}
      </div>
    </div>

    <article>
      <slot /> 
    </article>
    {frontmatter.dateWritten && <FocusedBottomBar />}
  </body>
</html>