---
interface Props {
  color?: string;
}
const { color = '#000' } = Astro.props;
---

<div id="whole-screen-scene" transition:persist data-color={color}>
  <div class="crt-scanlines"></div>
  <div class="crt-vignette"></div>
  <div class="crt-flicker"></div>
  <div class="crt-scan-roll"></div>
  <svg class="crt-noise" xmlns="http://www.w3.org/2000/svg">
    <filter id="noise">
      <feTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/>
      <feColorMatrix type="saturate" values="0"/>
      <feBlend in="SourceGraphic" mode="multiply"/>
    </filter>
    <rect width="100%" height="100%" filter="url(#noise)" opacity="0.08"/>
  </svg>
</div>

<div id="custom-cursor"></div>

<style>
  #whole-screen-scene {
    position: fixed;
    inset: 0;
    z-index: 100;
    pointer-events: none;
    opacity: 1;
    transition: opacity 0.2s ease, visibility 0.2s ease;
    overflow: hidden;
  }

  #whole-screen-scene.crt-hidden {
    opacity: 0;
    visibility: hidden;
  }

  /* Horizontal scanlines */
  .crt-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent,
      transparent 2px,
      rgba(0, 0, 0, 0.1) 2px,
      rgba(0, 0, 0, 0.1) 4px
    );
    pointer-events: none;
  }

  .crt-vignette {
    /* disabled */
  }

  .crt-flicker {
    position: absolute;
    inset: 0;
    background: transparent;
    pointer-events: none;
    animation: crt-flicker 0.15s infinite steps(1);
    opacity: 0;
  }

  @keyframes crt-flicker {
    0%   { opacity: 0; }
    5%   { opacity: 0.03; }
    10%  { opacity: 0; }
    50%  { opacity: 0.02; }
    75%  { opacity: 0; }
    90%  { opacity: 0.025; }
    100% { opacity: 0; }
  }

  .crt-noise {
    position: absolute;
    inset: -2%;
    width: 104%;
    height: 104%;
    pointer-events: none;
    mix-blend-mode: overlay;
    animation: crt-noise-shift 0.5s steps(1) infinite;
  }

  @keyframes crt-noise-shift {
    0%   { transform: translate(0, 0); }
    25%  { transform: translate(-1%, 1%); }
    50%  { transform: translate(1%, -1%); }
    75%  { transform: translate(-1%, -1%); }
    100% { transform: translate(0, 0); }
  }

  .crt-scan-roll {
    position: absolute;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(
      to bottom,
      transparent,
      rgba(255, 255, 255, 0.1),
      transparent
    );
    animation: crt-scan-roll 8s linear infinite;
    pointer-events: none;
  }

  @keyframes crt-scan-roll {
    from { top: -6px; }
    to   { top: 100%; }
  }

  #custom-cursor {
    position: fixed;
    pointer-events: none;
    width: 64px;
    height: 64px;
    background: url('/cursors/point.png') no-repeat center / contain;
    transform: translate(-10px, -2px);
    z-index: 9999;
    opacity: 1;
    left: -100px;
    top: -100px;
    transition: none;
  }
</style>

<script>
  let lastX = parseFloat(sessionStorage.getItem('cursor-x') || '-100');
  let lastY = parseFloat(sessionStorage.getItem('cursor-y') || '-100');
  let fadeTimeout: ReturnType<typeof setTimeout>;

  function getCursor() {
    return document.getElementById('custom-cursor');
  }

  function applyPosition(cursor: HTMLElement, x: number, y: number) {
    cursor.style.left = x + 'px';
    cursor.style.top  = y + 'px';
  }

  function resetFadeTimer(cursor: HTMLElement) {
    cursor.style.opacity = '1';
    cursor.style.transition = 'opacity 0.06s ease-in';

    clearTimeout(fadeTimeout);
    fadeTimeout = setTimeout(() => {
      cursor.style.transition = 'opacity 0.3s ease-out';
      cursor.style.opacity = '0';
    }, 1500);
  }

  const el = document.getElementById('whole-screen-scene')!;

  function applyCrtState() {
    const hidden = localStorage.getItem('crt-hidden') === 'true';
    el.classList.toggle('crt-hidden', hidden);
  }

  applyCrtState();

  document.addEventListener('astro:page-load', () => {
    const cursor = getCursor();
    applyPosition(cursor, lastX, lastY);
    resetFadeTimer(cursor);

    applyCrtState();
    el.style.backgroundColor = 'transparent';
    el.style.pointerEvents = 'none';
    el.style.zIndex = '-1';
    setTimeout(() => {
      el.style.zIndex = '100';
    }, 100);
  });

  document.addEventListener('astro:before-preparation', () => {
    el.style.opacity = '1';
    el.style.pointerEvents = 'all';
    el.style.backgroundColor = el.dataset.color!;
    el.style.zIndex = '100';
  });

  (window as any).toggleCrt = () => {
    const nowHidden = !el.classList.contains('crt-hidden');
    el.classList.toggle('crt-hidden', nowHidden);
    localStorage.setItem('crt-hidden', String(nowHidden));
  };

  document.addEventListener('mousemove', (e) => {
    lastX = e.clientX;
    lastY = e.clientY;
    sessionStorage.setItem('cursor-x', String(lastX));
    sessionStorage.setItem('cursor-y', String(lastY));
    const cursor = getCursor();
    applyPosition(cursor, lastX, lastY);
    resetFadeTimer(cursor);
  });

  document.addEventListener('mousedown', () => {
    getCursor().style.backgroundImage = "url('/cursors/closed.png')";
    resetFadeTimer(cursor);
  });

  document.addEventListener('mouseup', () => {
    getCursor().style.backgroundImage = "url('/cursors/point.png')";
    resetFadeTimer(cursor);
  });

  document.addEventListener('mouseleave', () => {
    getCursor().style.opacity = '0';
    resetFadeTimer(cursor);
  });

  document.addEventListener('mouseenter', (e) => {
    lastX = e.clientX;
    lastY = e.clientY;
    const cursor = getCursor();
    applyPosition(cursor, lastX, lastY);
    cursor.style.opacity = '1';
    resetFadeTimer(cursor);
  });
</script>