---
import '../styles/button.css'
const { href } = Astro.props;
---

<a href={href} class="wii-button">
    <div class="glare">
        <svg class="glare-left" viewBox="0 0 12 15" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#ffffff"
                d="M 12 0 C -2 0 -1 14 2 15 C 3 10 8 10 12 10Z" 
            />    
        </svg>
        <svg class="glare-center" viewBox="0 0 1 15" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <rect fill="#ffffff" width="100%" height="10"></rect>
        </svg>
        <svg class="glare-right" viewBox="0 0 10 15" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#ffffff"
                d="M 0 0 A1 1 0 0 1 0 10 M 0 10" 
            />    
        </svg>
    </div>
    <span class="button-text">
        <slot />
    </span>
</a>