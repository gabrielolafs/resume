---
import '../styles/button.css';
import '../styles/global.css';

const { href } = Astro.props;
---

<a href={href} class="wii-button">
    <div class="glare">
        <svg viewBox="0 0 93 18" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <filter id="f1" x="0" y="0" xmlns="http://www.w3/2000/svg">
                    <feGaussianBlur in="SourceGraphic" stdDeviation=".7" />
                </filter>
            </defs>
            
            <path filter="url(#f1)" fill="#ffffff" d="M 17 0 C 0 0 1 14 4 18 C 5 10 12 10 17 10 L 85 10 A1 .7 0 0 0 85 0" />
        </svg>
    </div>
    <span class="button-text">
        <slot />
    </span>
</a>