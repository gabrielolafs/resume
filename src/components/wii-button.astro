---
import '../styles/button.css'
const { href } = Astro.props;
---

<a href={href} class="wii-button">
    <div class="glare">
        <svg viewBox="0 0 100 15" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
            <path fill="#ffffff" d="M 18 0 C 1 0 2 14 5 15 C 6 10 13 10 18 10 Z" />
            <rect fill="#ffffff" x="18" y="0" width="72" height="10" />
            <path fill="#ffffff" d="M 90 0 A1 .7 0 0 1 90 10" />
        </svg>
    </div>
    <span class="button-text">
        <slot />
    </span>
</a>