---
import '../styles/bottom-bar.css'; 
---

<div class="bottom-container">
    <div class="top-of-bottom-container">
        <div class="left-line">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 4 6" preserveAspectRatio="none">
                <path stroke="var(--wii-blue)" stroke-width="1" d="M0 1 L4 1"></path>
                <rect x="0" y="1" width="4" height="5" fill="var(--background-color)"/>
            </svg>
        </div>
        <div class="left-curve">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="4 0 9 6" preserveAspectRatio="none">
                <path stroke="var(--wii-blue)" stroke-width="1" fill="none" d="M4 1 C7 1 8 5 13 5"></path>
                <path fill="var(--background-color)" d="M4 1 C7 1 8 5 13 5 L13 6 L4 6 Z"></path>
            </svg>
        </div>
        <div class="center-line">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="13 0 3 6" preserveAspectRatio="none">
                <path stroke="var(--wii-blue)" stroke-width="1" d="M13 5 L16 5"></path>
                <rect x="13" y="5" width="3" height="1" fill="var(--background-color)"/>
            </svg>
        </div>
        <div class="right-curve">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="16 0 8 6" preserveAspectRatio="none">
                <path stroke="var(--wii-blue)" stroke-width="1" fill="none" d="M16 5 C21 5 21 1 24 1"></path>
                <path fill="var(--background-color)" d="M16 5 C21 5 21 1 24 1 L24 6 L16 6 Z"></path>
            </svg>
        </div>
        <div class="right-line">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="24 0 6 6" preserveAspectRatio="none">
                <path stroke="var(--wii-blue)" stroke-width="1" d="M24 1 L30 1"></path>
                <rect x="24" y="1" width="6" height="5" fill="var(--background-color)"/>
            </svg>
        </div>
    </div>

    <div class="time-display">
        <span id="current-time">12:00</span>
    </div>
    
    <div class="rest-of-bottom-container">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1 1" preserveAspectRatio="none">
            <rect x="0" y="0" width="1" height="1" fill="var(--background-color)"/>
        </svg>
    </div>
</div>

<script>
    function updateTime() {
        const now = new Date();
        const hours = now.getHours();
        const minutes = now.getMinutes().toString().padStart(2, '0');
        const timeString = `${hours}:${minutes}`;
        const timeElement = document.getElementById('current-time');
        if (timeElement) {
            timeElement.textContent = timeString;
        }
    }

    updateTime();
    setInterval(updateTime, 1000);
</script>