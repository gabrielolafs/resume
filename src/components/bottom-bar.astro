                <rect x="0" y="7" width="10" height="23" fill="var(--background-color)"/>
            </svg>
        </div>
        <div class="right-curve">
            <svg viewBox="0 0 9 30" preserveAspectRatio="none" overflow="visible">
                <path fill="var(--background-color)" stroke="none" d="M0 7 C5 7 6 1 9 1 L9 30 L0 30 Z"/>
            </svg>
        </div>
        <div class="right-line">
            <svg viewBox="0 0 10 30" preserveAspectRatio="none" overflow="visible">
