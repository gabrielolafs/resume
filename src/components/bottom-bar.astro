---
import '../styles/bottom-bar.css'; 
import '../styles/global.css';
import CircleButton from './circle-button.astro';

const H = 30;
const LINE_W = 10;
const CURVE_W = 9;
const TOP = 0.25;
const DIP = 8
const BLEED = 1;
const ABOVE = 2;
const BELOW = H + 2;

const LINE_VB = `0 0 ${LINE_W} ${H}`;
const CURVE_VB = `0 0 ${CURVE_W} ${H}`;

const topLine = `M0 ${TOP} L${LINE_W} ${TOP}`;
const dipLine = `M0 ${DIP} L${LINE_W} ${DIP}`;
const leftEdge = `M${-BLEED} ${TOP} L0 ${TOP} C4 ${TOP} 4 ${DIP} ${CURVE_W} ${DIP} L${CURVE_W + BLEED} ${DIP}`;
const rightEdge = `M${-BLEED} ${DIP} L0 ${DIP} C5 ${DIP} 5 ${TOP} ${CURVE_W} ${TOP} L${CURVE_W + BLEED} ${TOP}`;

const dipAbove = `${dipLine} L${LINE_W} ${-ABOVE} L0 ${-ABOVE} Z`;
const leftAbove = `${leftEdge} L${CURVE_W + BLEED} ${-ABOVE} L${-BLEED} ${-ABOVE} Z`;
const rightAbove = `${rightEdge} L${CURVE_W + BLEED} ${-ABOVE} L${-BLEED} ${-ABOVE} Z`;

const dipBelow = `${dipLine} L${LINE_W} ${BELOW} L0 ${BELOW} Z`;
const leftBelow = `${leftEdge} L${CURVE_W + BLEED} ${BELOW} L${-BLEED} ${BELOW} Z`;
const rightBelow = `${rightEdge} L${CURVE_W + BLEED} ${BELOW} L${-BLEED} ${BELOW} Z`;
---

<div class="bottom-container" id="bottom-container">
    <div class="resume-button">
        <CircleButton href="./../../pdf/gabriel_olafsson_resume.pdf" openInNewTab="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 26">
                <path stroke-linecap="round" stroke-width="2" fill="var(--round-button-content)" stroke="var(--round-button-content)" d="M1 1L1 24 L19 24 L19 7 L13 1L1 1"></path>
                <path stroke-linecap="round" fill="none" stroke-width="1" stroke="var(--text-secondary)" d="M13 0.5 L13 6 Q13 7 14 7 L19.5 7"></path>
                <path stroke-linecap="round" stroke-width="1" stroke="var(--round-button-background)" d="M2 4L12 4M4 6L12 6M4 8L12 8M2 11L16 11M4 13L12 13M4 15L16 15M4 17L14 17M2 20L15 20M4 22L18 22"></path>
            </svg>
        </CircleButton>
        <div class="resume-background">
            <div class="fill-behind">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 13 14">
                    <path d="M0 1.4 L5.5 1.4 A1 1 0 0 1 5.5 11.4 L0 11.4" stroke-width=".3" stroke="#ababab"></path>
                    <path d="M0 1 L5 1 A1 1.05 0 0 1 5 11 L0 11"  stroke-width=".2" stroke="#c9c9c9"></path>
                </svg>
            </div>
            <div class="fill-left">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 8 14" preserveAspectRatio="xMinYMid meet">
                    <path d="M0 1.4 L13 1.4 M13 11.4 L0 11.4" stroke-width=".3" stroke="#ababab"></path>
                    <path d="M0 1 L13 1 M13 11 L0 11"  stroke-width=".2" stroke="#c9c9c9"></path>
                </svg>
            </div>
        </div>
    </div>

    <div class="email-button">
        <CircleButton href="./message-board">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 30">
                <defs>
                    <mask id="message-board-note">
                        <rect width="16" height="10" y="1" fill="white" rx=".5"/>
                        <path stroke="black" fill="none" stroke-linejoin="round"
                            d="M 0 1 L 8 7 L 16 1" 
                        />
                    </mask>
                </defs>

                <path fill="var(--round-button-content)" stroke-linejoin="round" stroke="var(--round-button-content)" stroke-width="2"
                    d="M 1 1 L 1 29 L 29 29 L 29 1 L 1 1 Z"
                />
                <g transform="translate(12 6)">
                    <rect width="18" height="12" x="-1" fill="var(--round-button-content)" rx=".5"/>
                    <rect height="20" width="20" mask="url(#message-board-note)" fill="var(--round-button-background)"/>
                </g>
                <g transform="translate(2 1)">
                    <rect width="18" height="12" x="-1" fill="var(--round-button-content)" rx=".5"/>
                    <rect height="20" width="20" mask="url(#message-board-note)" fill="var(--round-button-background)"/>
                </g>
                <g transform="translate(8 15)">
                    <rect width="18" height="12" x="-1" fill="var(--round-button-content)" rx=".5"/>
                    <rect height="20" width="20" mask="url(#message-board-note)" fill="var(--round-button-background)"/>
                </g>
            </svg>
        </CircleButton>
        <div class="email-background">
            <div class="fill-behind-right">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 13 14">
                    <path d="M13 1.4 L7.5 1.4 A1 1 0 0 0 7.5 11.4 L13 11.4" stroke-width=".3" stroke="#ababab"></path>
                    <path d="M13 1 L8 1 A1 1.05 0 0 0 8 11 L13 11" stroke-width=".2" stroke="#c9c9c9"></path>
                </svg>
            </div>
            <div class="fill-right">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" stroke="currentColor" viewBox="0 0 8 14" preserveAspectRatio="xMaxYMid meet">
                    <path d="M8 1.4 L-5 1.4 M-5 11.4 L8 11.4" stroke-width=".3" stroke="#ababab"></path>
                    <path d="M8 1 L-5 1 M-5 11 L8 11" stroke-width=".2" stroke="#c9c9c9"></path>
                </svg>
            </div>
        </div>
    </div>

    <!-- shadow pass (css blur handles making it look good) -->
    <div class="bottom-container-shadow-pass">
        <div class="left-line">
            <svg viewBox={LINE_VB} preserveAspectRatio="none">
                <path class="bar-shadow bar-shadow--line" d={topLine} />
            </svg>
        </div>
        <div class="left-curve">
            <svg viewBox={CURVE_VB} preserveAspectRatio="none">
                <defs><clipPath id="bar-clip-left"><path d={leftBelow} /></clipPath></defs>
                <path class="bar-shadow bar-shadow--curve" d={leftEdge} clip-path="url(#bar-clip-left)" />
            </svg>
        </div>
        <div class="center-line">
            <svg viewBox={LINE_VB} preserveAspectRatio="none">
                <defs><clipPath id="bar-clip-center"><path d={dipBelow} /></clipPath></defs>
                <path class="bar-shadow bar-shadow--line" d={dipLine} clip-path="url(#bar-clip-center)" />
            </svg>
        </div>
        <div class="right-curve">
            <svg viewBox={CURVE_VB} preserveAspectRatio="none">
                <defs><clipPath id="bar-clip-right"><path d={rightBelow} /></clipPath></defs>
                <path class="bar-shadow bar-shadow--curve" d={rightEdge} clip-path="url(#bar-clip-right)" />
            </svg>
        </div>
        <div class="right-line">
            <svg viewBox={LINE_VB} preserveAspectRatio="none">
                <path class="bar-shadow bar-shadow--line" d={topLine} />
            </svg>
        </div>
    </div>

    <!-- highlight pass -->
    <div class="bottom-container-highlight-pass">
        <div class="left-line">
            <svg viewBox={LINE_VB} preserveAspectRatio="none">
                <path class="bar-edge" d={topLine} />
            </svg>
        </div>
        <div class="left-curve">
            <svg viewBox={CURVE_VB} preserveAspectRatio="none">
                <path class="bar-mask" d={leftAbove} />
                <path class="bar-edge" d={leftEdge} />
            </svg>
        </div>
        <div class="center-line">
            <svg viewBox={LINE_VB} preserveAspectRatio="none">
                <path class="bar-mask" d={dipAbove} />
                <path class="bar-edge" d={dipLine} />
            </svg>
        </div>
        <div class="right-curve">
            <svg viewBox={CURVE_VB} preserveAspectRatio="none">
                <path class="bar-mask" d={rightAbove} />
                <path class="bar-edge" d={rightEdge} />
            </svg>
        </div>
        <div class="right-line">
            <svg viewBox={LINE_VB} preserveAspectRatio="none">
                <path class="bar-edge" d={topLine} />
            </svg>
        </div>
    </div>
    
    <div class="time-display">
        <span id="current-time">
            <span id="time-hours"></span><span class="colon">:</span><span id="time-minutes"></span>
        </span>
    </div>

    <div class="date-display">
        <span id="current-date"></span>
    </div>

</div>
<script>
  const DAYS = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

  function updateClock() {
    const hours = document.getElementById("time-hours");
    const minutes = document.getElementById("time-minutes");
    const date = document.getElementById("current-date");
    if (!hours || !minutes || !date) return; // clock isn't on this page

    const now = new Date();
    hours.textContent = now.getHours().toString().padStart(2, "0");
    minutes.textContent = now.getMinutes().toString().padStart(2, "0");
    date.textContent = `${DAYS[now.getDay()]} ${now.getMonth() + 1}/${now.getDate()}`;
  }

  updateClock();
  setInterval(updateClock, 60_000);
  document.addEventListener("astro:page-load", updateClock);
</script>