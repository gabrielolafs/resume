---
import '../styles/focused-bottom-bar.css';
import WiiButton from './wii-button.astro';
---

<div class="focused-bottom-container">
    <div class="coloring">
        <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" overflow="visible" viewBox="0 0 24 24">
            <path fill="var(--background-color)" stroke="var(--wii-blue-darker)" stroke-width=".3" d="M-1 1 Q12 0 25 1 L25 25 L-1 25 Z"></path>
        </svg>
    </div>
    <div class="buttons">
        <WiiButton href="/">Home</WiiButton>
        <WiiButton href="/">not home</WiiButton>
    </div>
</div>