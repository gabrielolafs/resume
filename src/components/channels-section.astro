---
import '../styles/channel.css';
import '../styles/animations.css';
import '../styles/global.css'
import '../styles/arrows.css';
import overrides from '../data/channels-with-order.json';
import LoadingScreen from './loading-screen.astro';
import EmbeddedChannel from './embedded-channel.astro';
import LeftArrow from '../../public/svg/left-arrow.svg';

const globbed = import.meta.glob('../pages/articles/*.md', { eager: true });

function getRandomDirection() {
    return Math.random() < 0.5 ? -1 : 1;
}

const channels = Object.entries(globbed)
.map(([filepath, mod]: [string, any]) => {
    const slug = filepath.split('/').pop()!.replace(/\.md$/, '');
    const overrideIndex = (overrides as any[]).findIndex(o => o === slug);
    const override = (overrides as any[]).find(o => o === slug);

    if (!override) return null;
    return {
        order: overrideIndex,
        title:   mod.frontmatter.title,
        url:     `/articles/${slug}`,
        scanDir: mod.frontmatter.model?.baseDir ?? mod.frontmatter.channelPageScanDir,
        animationSvg: mod.frontmatter.animationSvgDir ? mod.frontmatter.animationSvgDir : `/svg/mask-star.svg`,
        animationSvgDimentions: mod.frontmatter.animationSvgDimentions ?? [90.45, 43.61], // default to size of mask-star.svg. this could have its own json with options if i get around to making more default svgs
        imgPaths: mod.frontmatter.imgPaths ? mod.frontmatter.imgPaths : [],
        model:   { 
            position: [0,0,0], // normalized in blender
            baseRotation: mod.frontmatter.model?.baseRotation ?? [0,5,0],
            color: mod.frontmatter.color ?? [250,250,250],
            animatedRotation: mod.frontmatter.animatedRotation ?? [1,1,0], 
            scale: mod.frontmatter.scale ?? 1,
            direction: mod.frontmatter.direction ?? getRandomDirection(),
            salt: Math.random(), 
            saltBounce: Math.random()
        }, 
    };
})
.filter(Boolean)
.sort((a, b) => a.order - b.order);

const channelsJson = JSON.stringify(channels);

---

{channels.map((ch) => {
  const slug = ch.url?.split('/').pop();
  return (
    <template data-slug={slug}>
      <EmbeddedChannel
        title={ch.title}
      />
    </template>
  );
})}

<LoadingScreen/> 

<div id="zoom-clone-layer"></div>
<div id="zoom-background"></div>

<div class="top-container">
  <canvas id="three-canvas" data-channels={channelsJson} style="pointer-events: none;"></canvas>
  <canvas id="zoom-canvas"></canvas>
  <div id="page-track" class="page-track"></div>
  <button id="arrow-prev" class="page-arrow left">
    <LeftArrow />
  </button>
  <button id="arrow-next" class="page-arrow right">
    <LeftArrow />
  </button>
</div>

<script>
    import { initChannelPage } from '../lib/channel-page';
    initChannelPage();
</script>