---
import '../styles/channel.css';
import '../styles/animations.css';
import '../styles/global.css'
import overrides from '../data/channels-with-order.json';
import LoadingScreen from './loading-screen.astro';
import EmbeddedChannel from './embedded-channel.astro';

const globbed = import.meta.glob('../pages/articles/*.md', { eager: true });

function getRandomDirection() {
    return Math.random() < 0.5 ? -1 : 1;
}

const channels = Object.entries(globbed)
.map(([filepath, mod]: [string, any]) => {
    const slug = filepath.split('/').pop()!.replace(/\.md$/, '');
    const overrideIndex = (overrides as any[]).findIndex(o => o.slug === slug);
    const override = (overrides as any[]).find(o => o.slug === slug);

    if (!override) return null;
    return {
        order: overrideIndex,
        title:   mod.frontmatter.title,
        url:     `/articles/${slug}`,
        scanDir: override.model?.baseDir ?? mod.frontmatter.channelPageScanDir,
        animationSvg: override.animationSvgDir ? override.animationSvgDir : `/svg/mask-star.svg`,
        animationSvgDimentions: override.animationSvgDimentions ? override.animationSvgDimentions : [90.45, 43.61], // default to size of mask-star.svg. this could have its own json with options if i get around to making more default svgs
        imgPaths: override.imgPaths ? override.imgPaths : [],
        model:   { 
            position: override.model?.position ?? [0,0,0], 
            baseRotation: override.model?.baseRotation ?? [0,5,0],
            color: override.color ?? [250,250,250],
            animatedRotation: override.model?.animatedRotation ?? [1,1,0], 
            scale: override.model?.scale ?? 1,
            direction: override.model?.direction ?? getRandomDirection(),
            salt: Math.random(), 
            saltBounce: Math.random()
        }, 
    };
})
.filter(Boolean)
.sort((a, b) => a.order - b.order);

const channelsJson = JSON.stringify(channels);

const leftFacingArrow = `<svg xmlns="http://www.w3.org/2000/svg" stroke="currentColor" viewBox="0 0 16 24">
        <defs>
            <radialGradient id="grad1" cx="85%" cy="5%" r="100%" fx="85%" fy="15%">
                <stop offset="0%" stop-color="var(--arrow-fill-dark)"/>
                <stop offset="100%" stop-color="var(--arrow-fill-light)" stop-opacity="0.4"/>
            </radialGradient>
            <radialGradient id="grad2" cx="85%" cy="95%" r="90%" fx="85%" fy="95%">
                <stop offset="0%" stop-color="var(--arrow-fill-dark)"/>
                <stop offset="100%" stop-color="var(--arrow-fill-light)" stop-opacity="0.4"/>
            </radialGradient>
        </defs>
        <path stroke-linecap="round" stroke="var(--arrow-fill-dark)" stroke-linejoin="round" fill="url(#base)" stroke-width="1" 
            d="M13 23 L2 12 L13 1 C13.5 9 13 10 12.5 11 Q11.9 12 12.5 13 C13 14 13.5 15 13 23"/>
        <path stroke="none" fill="url(#grad1)" 
            d="M13 23 L2 12 L13 1 C13.5 9 13 10 12.5 11 Q11.9 12 12.5 13 C13 14 13.5 15 13 23" />
        <path stroke="none" fill="url(#grad2)" 
            d="M13 23 L2 12 L13 1 C13.5 9 13 10 12.5 11 Q11.9 12 12.5 13 C13 14 13.5 15 13 23" />
        <path stroke-linecap="round" stroke="var(--arrow-stroke)" stroke-linejoin="round" fill="none" stroke-width="1" 
            d="M13 23 L2 12 L13 1 C13.5 9 13 10 12.5 11 Q11.9 12 12.5 13 C13 14 13.5 15 13 23" />
        </svg>`

// right below me, I want to swap over loading screen only to happen on the initial load of the page or referesh.
// (todo: zooming) will be called whenever routing somewhere that is not itself.
---

{channels.map((ch) => {
  const slug = ch.url?.split('/').pop();
  return (
    <template data-slug={slug}>
      <EmbeddedChannel
        // title={ch.title}
      />
    </template>
  );
})}

<LoadingScreen/>
<div id="zoom-clone-layer"></div>
<div id="zoom-background"></div>

<div class="top-container">
  <canvas id="three-canvas" data-channels={channelsJson} style="pointer-events: none;"></canvas>
  <canvas id="zoom-canvas"></canvas>
  <div id="page-track" class="page-track"></div>
  <button id="arrow-prev" class="page-arrow left" set:html={leftFacingArrow}></button>
  <button id="arrow-next" class="page-arrow right" set:html={leftFacingArrow}></button>
</div>

<style>
  #zoom-canvas {
    position: fixed;
    inset: 0;
    width: 100dvw;
    height: 100dvh;
    z-index: 99;
  }

  #zoom-clone-layer {
    position: fixed;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  #zoom-background {
    opacity: 0; 
    background: black; 
    z-index: 0; 
    height: 100dvh; 
    width: 100dvw; 
    position: absolute; 
    top: 0; 
    left: 0; 
    pointer-events: none;
  }
</style>

<script >
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
    import { navigate } from 'astro:transitions/client';

    type FlipState = {
        active: Boolean,
        from: number,
        to: number,
        start: number,
        duration: number
    }

    type channelLayout = {
        page: number,
        cols: number,
        rows: number,
        cpp: number
    }

    type ZoomState = {
        active: boolean,
        start: number,
        pageIndex: number,
        cellIndex: number,
        fromRect: DOMRect,
        href: string,
        cloneEl: HTMLElement | null,
        fadingOutEls: HTMLElement[],
        fadingInEls: HTMLElement[],
        startPos: THREE.Vector3
    }

    // load the compressed 3d objects
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.6/');
    const gltfLoader = new GLTFLoader();
    gltfLoader.setDRACOLoader(dracoLoader);

    declare global {
        interface Window {
            __modelCache: Map<string, THREE.Group>;
        }
    }
    
    window.__modelCache = window.__modelCache ?? new Map();
    
    const MIN_MS_OF_LOADING_SCREEEN = 500;
    const ZOOM_DURATION = 600; //ms

    let pageEls: HTMLElement[] = [];
    let animFrameId: number;

    document.addEventListener('astro:page-load', () => {
        const canvas = document.getElementById('three-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        let flipState: FlipState = {
            active: false,
            from: 0,
            to: 1,
            start: 0,
            duration: 600 // ms
        };

        let channelLayout: channelLayout = {
            page: 0,
            cols: 4,
            rows: 3,
            cpp: 12 
        };

        const container = canvas.parentElement!;
        const allChannels = JSON.parse(canvas.dataset.channels ?? '[]');

        const overlay = document.getElementById('loading-overlay');

        let pages = buildPages(channelLayout.cpp, allChannels);

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(devicePixelRatio);

        const scene = new THREE.Scene();

        const w0 = container.clientWidth;
        const h0 = container.clientHeight;
        const camera = new THREE.OrthographicCamera(-w0/2, w0/2, h0/2, -h0/2, 0.1, 1000);
        camera.position.set(0, 0, 200);
        camera.lookAt(0, 0, 0);
        renderer.setSize(w0, h0);
        scene.add(camera);

        const ambient = new THREE.AmbientLight(0xffffff, 3);
        scene.add(ambient);
        const directionalLight = new THREE.DirectionalLight(0xffffff, 1.0);
        directionalLight.position.set(0, 10, 10);
        scene.add(directionalLight);

        // --- zoom stage: transparent on top and spanning below
        const zoomCanvas = document.getElementById('zoom-canvas') as HTMLCanvasElement;
        const zoomCloneLayer = document.getElementById('zoom-clone-layer') as HTMLElement;
        const zoomRenderer = new THREE.WebGLRenderer({ canvas: zoomCanvas, antialias: true, alpha: true });
        zoomRenderer.setPixelRatio(devicePixelRatio);
        const zoomScene = new THREE.Scene();
        const zoomCamera = new THREE.OrthographicCamera(-w0/2, w0/2, h0/2, -h0/2, 0.1, 1000);
        zoomCamera.position.set(0, 0, 200);
        zoomCamera.lookAt(0, 0, 0);
        zoomRenderer.setSize(w0, h0);
        zoomScene.add(zoomCamera);
        zoomScene.add(new THREE.AmbientLight(0xffffff, 3));
        const zoomDirLight = new THREE.DirectionalLight(0xffffff, 1.0);
        zoomDirLight.position.set(0, 10, 10);
        zoomScene.add(zoomDirLight);

        // in case we navigated back here mid-fade from a previous zoom
        setBackgroundOpacity(1);
        zoomCanvas.style.display = 'none';

        let zoomedGroup: THREE.Group | null = null;
        let zoomState: ZoomState = {
            active: false,
            start: 0,
            pageIndex: 0,
            cellIndex: 0,
            fromRect: new DOMRect(),
            href: '',
            cloneEl: null,
            fadingInEls: [],
            fadingOutEls: [],
            startPos: new THREE.Vector3()
        };

        let pendingPage = 0;

        const cellGroups: THREE.Group[][] = [];

        for (let p = 0; p < 2; p++) {
            const page: THREE.Group[] = [];
            for (let i = 0; i < channelLayout.cols * channelLayout.rows; i++) {
                const g = new THREE.Group();
                scene.add(g);
                page.push(g);
            }
            cellGroups.push(page);
        }

        switchLayout();
        setup();
        updateArrows();
        loadchannels();

        animFrameId = requestAnimationFrame(animate);

        window.addEventListener('resize', () => {
            switchLayout();
            setup();

            const w = container.clientWidth;
            const h = container.clientHeight;
            zoomRenderer.setSize(w, h);
            zoomCamera.left = -w / 2;
            zoomCamera.right = w / 2;
            zoomCamera.top = h / 2;
            zoomCamera.bottom = -h / 2;
            zoomCamera.updateProjectionMatrix();
        });

        document.getElementById('arrow-prev')?.addEventListener('click', () => startFlip(channelLayout.page - 1));
        document.getElementById('arrow-next')?.addEventListener('click', () => startFlip(channelLayout.page + 1));

        document.getElementById('page-track')?.addEventListener('click', (e) => {
            const anchor = (e.target as HTMLElement).closest('.channel-cell') as HTMLAnchorElement | null;
            if (!anchor || anchor.classList.contains('is-default-color')) return;

            const pageEl = anchor.closest('.channel-page') as HTMLElement | null;
            if (!pageEl) return;

            const pageIndex = Number(pageEl.dataset.page);
            const cellIndex = Array.from(pageEl.querySelectorAll('.channel-cell')).indexOf(anchor);
            const ch = pages[pageIndex]?.[cellIndex];
            if (!ch?.url) return;

            e.preventDefault();
            startZoom(pageIndex, cellIndex, anchor, ch.url);
        });

        function buildPages(cpp: number, chs: any[]) {
            const padded = [
                ...chs,
                ...Array.from({ length: Math.max(0, 2 * cpp - chs.length) }, () => ({ // fill rest of page + whole next page with blank
                    title: 'static',
                    model: {
                        color: [9,9,9],
                        salt: Math.random(),
                        saltBounce: Math.random()
                    }
                }))
            ];
            return Array.from({ length: Math.ceil(padded.length / cpp) }, (_, i) =>
                padded.slice(i * cpp, (i + 1) * cpp)
            );
        }

        function setup() {
            const w = container.clientWidth;
            const h = container.clientHeight;
            renderer.setSize(w, h);

            camera.left   = -w / 2;
            camera.right  =  w / 2;
            camera.top    =  h / 2;
            camera.bottom = -h / 2;
            camera.updateProjectionMatrix();

            const padX = w * 0.05;
            const usableW = w - padX * 2;
            const cellW = usableW / channelLayout.cols;
            const cellH = h / channelLayout.rows;

            cellGroups.forEach((page, p) => {
                page.forEach((group, i) => {
                    if (i >= channelLayout.cpp) {
                        group.position.set(-99999, -99999, 0);
                        return;
                    }
                    const col = i % channelLayout.cols;
                    const row = Math.floor(i / channelLayout.cols);
                    group.position.set(
                        p * w * 0.9 + padX + (col + 0.5) * cellW - w / 2 - channelLayout.page * w * 0.9,
                        h / 2 - (row + 0.5) * cellH,
                        0
                    );
                    scaleGroup(p, i);
                });
            });
            renderPageTrack();
            layoutPageTrack();
        }

        function scaleGroup(pageIndex: number, cellIndex: number) {
            const group = cellGroups[pageIndex][cellIndex];
            const ch = pages[pageIndex][cellIndex];
            const w = container.clientWidth;
            const h = container.clientHeight;
            const padX = w * 0.05;
            const usableW = w - padX * 2;
            const cellW = usableW / channelLayout.cols;
            const cellH = h / channelLayout.rows;
            const cellSize = Math.min(cellW, cellH);

            group.children.forEach(child => {
                if (child.userData.isBackground) return;
                if (!ch) return;

                child.scale.set(1,1,1);

                const box = new THREE.Box3().setFromObject(child);
                const size = new THREE.Vector3();
                box.getSize(size);
                const longest = Math.max(size.x, size.y, size.z);
                if (longest > 0 && isFinite(longest)) {
                    child.scale.setScalar((cellSize * 0.55 * ch.model.scale) / longest);
                }
            });

            const outlinePx = 3;
            const cardGap = 25; 

            group.children.forEach(child => {
                if (!child.userData.isBackground) return;
                const shrink = child.userData.isOutline ? cardGap : cardGap + outlinePx * 3;
                child.scale.set(
                    (cellW - shrink) / 50,
                    (cellH - shrink) / 50,  
                    1
                );
            });
        }

        function mulberry32(seed: number) {
            let state = Math.floor(seed * 0xFFFFFFFF) >>> 0;

            return function () {
                state = (state + 0x6D2B79F5) | 0;
                let t = state;
                t = Math.imul(t ^ (t >>> 15), t | 1);
                t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
        }

        function buildNoiseAnimation(salt: number) {
            const rand = mulberry32(salt);

            const animation = `noise_shift_${salt.toString(36).replace(/\./g, "_")}`;

            const frames = 120; 
            const range = 100;       // ±px movement

            const keyframes = [];

            for (let i = 0; i <= frames; i++) {
                const pct = (i / frames) * 100;

                const x = Math.round((rand() * 2 - 1) * range / 2);
                const y = Math.round((rand() * 2 - 1) * range);

                keyframes.push(`${pct}%{transform:translate(${x}px,${y}px);}`);
                keyframes.push(`${pct - (1 / frames) * 100 + .00001}%{transform:translate(${x}px,${y}px);}`);
                
            }

            return `
                <style>
                @keyframes ${animation}{
                ${keyframes.join("")}
                }
                </style>

                <div class="little-logo">
                    GGO
                </div>

                <div
                    class="static-noise"
                    style="animation: ${animation} linear 15s infinite;">
                </div>
                
                `;
        }

        // experimenting with different timing from the salt, not 100% sold atm. maybe if i can get some ts that reads the size of the images and uses that to have
        function buildChannelSection( salt: number, title: string, animationSvg: string, svgDimentions: number[] | undefined, imgPaths: string[] ) {
            const slug = title.replaceAll(/[^a-zA-Z0-9\-._~]/g, "_"); // all url un safe chars
            const highlightedTitle = `
                        <div class="channel-name" style="-webkit-text-stroke-width: 8px; -webkit-text-stroke-color: black;">
                            ${title}
                        </div>
                        <div class="channel-name">
                            ${title}
                        </div>`;

            // no images, fall back to the drifting background svg
            if (imgPaths.length === 0) {
                const dims = svgDimentions ?? [1, 1];
                const aspectRatio = dims[0] / dims[1];
                const offSetYTimes = Math.trunc(aspectRatio);

                return `<style>
                            @keyframes drift_${slug} {
                                0% { transform: translate(0, 0); }
                                100% { transform: translate(${aspectRatio * 2.5}dvh, ${2.5 * offSetYTimes}dvh); }
                            }
                        </style>
                        <div class="grid-mover" 
                            style="background-image: url('${animationSvg}'); animation: drift_${slug} ${4 + salt}s linear infinite;"
                        >
                        </div>` + highlightedTitle;
            }

            // images present crossfade slideshow
            const perImageDuration = 4 + salt;
            const totalDuration = perImageDuration * imgPaths.length;
            const slot = 100 / imgPaths.length;
            const fadeEdge = slot * 0.15;

            const layers = imgPaths.map((path, i) => {
                const delay = -(i * perImageDuration);  // negative delay pre-offsets each image into its own slot
                return `<img
                            src="${path}"
                            class="fade-layer"
                            style="animation: fade_${slug} ${totalDuration}s ease-in-out infinite; animation-delay: ${delay}s;"
                        />`;
            }).join("");

            return `<style>
                        @keyframes fade_${slug} {
                            0% { opacity: 1; }
                            ${slot - fadeEdge}% { opacity: 1; }
                            ${slot}% { opacity: 0; }
                            ${100 - fadeEdge}% { opacity: 0; }
                            100% { opacity: 1; }
                        }
                        .fade-stack {
                            position: relative;
                            width: 100%;
                            height: 100%;
                        }
                        .fade-layer {
                            position: absolute;
                            inset: 0;
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            opacity: 0;
                        }
                    </style>
                    <div class="fade-stack">
                        ${layers}
                    </div>` + highlightedTitle;
        }

        function cellMarkup(ch: any) {
            const isDefaultColor = ch.model.color.every((v: number, i: number) => v === [9, 9, 9][i]);
            const slug = ch.url?.split('/').pop();


            return `
                <a class="channel-cell${isDefaultColor ? ' is-default-color' : ''}" href="${ch.url || '#'}" ${isDefaultColor ? `style="pointer-events: none;"` : ''}>
                    <svg viewBox="0 0 50 50" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M 1 3
                            Q 0 25 1 47
                            Q 1.0417 48.9583 3 49
                            Q 25 50 47 49
                            Q 48.9583 48.9583 49 47
                            Q 50 25 49 3
                            Q 48.9583 1.0417 47 1
                            Q 25 0 3 1
                            Q 1.0417 1.0417 1 3
                            Z"
                            fill="rgb(${ch.model.color[0]}, ${ch.model.color[1]}, ${ch.model.color[2]})"
                            stroke="none"
                        />
                    </svg>
                    <div class="grid-wrap">

                    ${isDefaultColor
                        ? buildNoiseAnimation(ch.model.salt)
                        : buildChannelSection(ch.model.salt, ch.title, ch.animationSvg, ch.animationSvgDimentions, ch.imgPaths )
                    }

                    ${document.querySelector(`template[data-slug="${slug}"]`)?.innerHTML ?? ""}
                    
                    </div>

                    <svg viewBox="0 0 50 50" preserveAspectRatio="none" width="100%" height="100%">
                        <defs>
                            <mask id="mask01">
                                <rect width="100" height="100" fill="white"/>
                                <path
                                    d="M 1 3
                                    Q 0 25 1 47
                                    Q 1.0417 48.9583 3 49
                                    Q 25 50 47 49
                                    Q 48.9583 48.9583 49 47
                                    Q 50 25 49 3
                                    Q 48.9583 1.0417 47 1
                                    Q 25 0 3 1
                                    Q 1.0417 1.0417 1 3
                                    Z"
                                    fill="black"
                                />
                            </mask>
                        </defs>
                        <g mask="url(#mask01)">
                            <path fill="var(--wii-background)" fill-opacity="1"
                            d="M -100 -100
                            L200 -100
                            L200 100
                            L-100 100
                            Z" /> 
                        </g>
                        <path
                            class="cell-outline"
                            d="M 1 3
                            Q 0 25 1 47
                            Q 1.0417 48.9583 3 49
                            Q 25 50 47 49
                            Q 48.9583 48.9583 49 47
                            Q 50 25 49 3
                            Q 48.9583 1.0417 47 1
                            Q 25 0 3 1
                            Q 1.0417 1.0417 1 3
                            Z"
                            fill="none"
                            stroke="#afafaf"
                            stroke-width=".8"
                        />
                    </svg>
                </a>
            `;
        }

        function updateArrows() {
            const prev = document.getElementById('arrow-prev') as HTMLButtonElement;
            const next = document.getElementById('arrow-next') as HTMLButtonElement;
            prev.style.visibility = channelLayout.page === 0 ? 'hidden' : 'visible';
            next.style.visibility = channelLayout.page >= pages.length - 1 ? 'hidden' : 'visible';
        }

        function teardownModels() {
            cellGroups.forEach(page => {
                page.forEach(group => {
                    while (group.children.length > 0) {
                        const child = group.children[0];
                        group.remove(child);
                        if (child instanceof THREE.Mesh) {
                            child.geometry.dispose();
                            if (Array.isArray(child.material)) {
                                child.material.forEach((m: THREE.Material) => m.dispose());
                            } else {
                                (child.material as THREE.Material).dispose();
                            }
                        }
                    }
                });
            });
        }

        function switchLayout() { // only have to account for the cols changing. not the rows
            const ratio = container.clientHeight / container.clientWidth;
            const newCols = ratio > 1 ? 2 : 4;
            const newCpp = newCols * channelLayout.rows;

            if ( newCols === channelLayout.cols ) return;

            const firstChannelIndex = channelLayout.page * channelLayout.cpp;

            channelLayout.cols = newCols;
            channelLayout.cpp = newCpp;

            pages = buildPages(channelLayout.cpp, allChannels);
            channelLayout.page = Math.floor(firstChannelIndex / channelLayout.cpp);

            teardownModels();

            setup();
            renderPageTrack();
            layoutPageTrack();
            updateArrows();

            loadchannels();
        }

        // this function changes the baked lighting of an obj. it is only used for the mii, and this will be removed come animations
        function applyFillLight(root: THREE.Object3D, boost = 2.0) {
            root.traverse((child) => {
                const mesh = child as THREE.Mesh;
                if (!mesh.isMesh) return;
                const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
                mats.forEach((mat: any) => {
                    // only flat-Kd materials (hair/pants/shirt/skin/beard) need this correction.
                    if (mat.map) return;
                    if (mat.color) mat.color.multiplyScalar(boost); // scales diffuse reflectance, not a flat overlay
                    if (mat.emissive) {
                        const peak = Math.max(mat.color.r, mat.color.g, mat.color.b, 1e-4);
                        mat.emissive.copy(mat.color).multiplyScalar(0.01 / peak);
                    }
                });
            });
        }

        function loadchannels() {
            const minWait = new Promise(resolve => setTimeout(resolve, MIN_MS_OF_LOADING_SCREEEN));

            for (let p = 0; p < cellGroups.length; p++) {
                for (let i = 0; i < channelLayout.cpp; i++) {
                    loadchannel(p, i);
                }
            }

            // render all channels + unload loading screen
            Promise.all([minWait]).then(() => {
                if (overlay) {
                    overlay.style.opacity = '0';
                    setTimeout(() => overlay.remove(), MIN_MS_OF_LOADING_SCREEEN);
                }
                renderer.compile(scene, camera);
            });
        }

        function loadchannel(pageIndex: number, cellIndex: number) {
            const ch = pages[pageIndex]?.[cellIndex];
            if (!ch) return;

            const cacheKey = ch.scanDir;

            if (window.__modelCache.has(cacheKey)) { // cached
                const cached = window.__modelCache.get(cacheKey)!.clone();
                cached.position.set(...ch.model.position);
                cellGroups[pageIndex][cellIndex].add(cached);
                scaleGroup(pageIndex, cellIndex);
                return;
            }

            if (!ch?.scanDir) { // no model? no need to load a model.
                return;
            }

            const dir = ch.scanDir.replace(/\/$/, '');
            const glbPath = `${dir}.glb`;

            gltfLoader.load(
                glbPath,
                (gltf) => {
                    const root = gltf.scene;
                    root.position.set(...ch.model.position);

                    if (ch.title === 'About Me' || ch.title === 'About Mii') { // temp, remove come animations
                        applyFillLight(root);
                    }

                    cellGroups[pageIndex][cellIndex].add(root);
                    scaleGroup(pageIndex, cellIndex);
                    window.__modelCache.set(cacheKey, root.clone());
                },
                undefined,
                (err) => console.warn(`GLB load failed [${ch.title}]:`, err)
            );
        }

        function startFlip(targetPage: number) {
            if (flipState.active || zoomState.active || targetPage < 0 || targetPage >= pages.length) return;
            console.log(flipState);
            console.log(targetPage);
            const w = container.clientWidth;
            flipState = { active: true, from: channelLayout.page * w * 0.9, to: targetPage * w * 0.9, start: performance.now(), duration: 600 };
            pendingPage = targetPage;
        }

        // Zoom-in
        function backgroundLayers(): HTMLElement[] {
            return [
                canvas,
                document.getElementById('page-track'),
                document.getElementById('arrow-prev'),
                document.getElementById('arrow-next'),
                document.getElementById('bottom-container')
            ].filter(Boolean) as HTMLElement[];
        }

        function setBackgroundOpacity(value: number) {
            backgroundLayers().forEach(el => { el.style.opacity = `${value}`; });
        }

        function startZoom(pageIndex: number, cellIndex: number, anchorEl: HTMLAnchorElement, href: string) {
            if (flipState.active || zoomState.active) return;

            const rect = anchorEl.getBoundingClientRect();
            const clone = anchorEl.cloneNode(true) as HTMLElement;
            clone.style.position = 'fixed';
            clone.style.top = `${rect.top}px`;
            clone.style.left = `${rect.left}px`;
            clone.style.width = `${rect.width}px`;
            clone.style.height = `${rect.height}px`;
            
            clone.style.margin = '0';
            clone.style.transformOrigin = 'center center';
            clone.style.pointerEvents = 'none';

            zoomCloneLayer.innerHTML = '';
            zoomCloneLayer.appendChild(clone);

            // const chromeEls = [] as HTMLElement[];
            // const chromeEls = Array.from(clone.querySelectorAll(':scope > svg')) as HTMLElement[];
            // console.log(chromeEls);

            const embedded = clone.querySelector('.embedded-channel') as HTMLElement | null;
            const blackBackground = document.getElementById('zoom-background');
            const fadingInEls = embedded ? [embedded, blackBackground] : [blackBackground];
            const fadingOutEls = Array.from(clone.querySelectorAll(':scope > svg')) as HTMLElement[];
            

            anchorEl.style.visibility = 'hidden'; 

            const group = cellGroups[pageIndex]?.[cellIndex] ?? null;
            const startPos = group ? group.position.clone() : new THREE.Vector3();
            if (group) {
                zoomScene.add(group);
                group.scale.set(1, 1, 1);
            }
            zoomedGroup = group;

            zoomState = {
                active: true,
                start: performance.now(),
                pageIndex,
                cellIndex,
                fromRect: rect,
                href,
                cloneEl: clone,
                fadingInEls,
                fadingOutEls,
                startPos
            };

            zoomCanvas.style.display = 'block';

            if (zoomState.cloneEl) {
                const cloneEl = zoomState.cloneEl;

                cloneEl.style.transition = 'none';
                cloneEl.style.transform = 'translate(0px, 0px) scale(1, 1)';

                void cloneEl.offsetWidth;

                const eased = 1;
                const vw = window.innerWidth;
                const vh = window.innerHeight;
                const from = zoomState.fromRect;
                const fromCx = from.left + from.width / 2;
                const fromCy = from.top + from.height / 2;
                const scaleX = vw / from.width;
                const scaleY = vh / from.height;
                const curScaleX = 1 + (scaleX - 1) * eased;
                const curScaleY = 1 + (scaleY - 1) * eased;
                const dx = (vw / 2 - fromCx) * eased;
                const dy = (vh / 2 - fromCy) * eased + eased * 17;

                cloneEl.style.transition = `transform ${ZOOM_DURATION - 10}ms linear`;
                requestAnimationFrame(() => {
                    cloneEl.style.transform = `translate(${dx}px, ${dy}px) scale(${curScaleX}, ${curScaleY})`;
                });
            }
        }

        function stepZoom(now: number) {
            const t = Math.min((now - zoomState.start) / ZOOM_DURATION, 1);
            const eased = t;

            const vh = window.innerHeight;
            const from = zoomState.fromRect;
            const scaleY = vh / from.height;
            const curScaleY = 1 + (scaleY - 1) * eased;

            zoomState.fadingInEls.forEach(el => { el.style.opacity = `${eased + .2}`; });
            zoomState.fadingOutEls.forEach(el => { el.style.opacity = `${1 - eased - .2}`; });


            if (zoomedGroup) { // model zooming (a little wonky atm todo: fix the bottom left comming from the bottom. its some sort of math problem)
                zoomedGroup.position.x = zoomState.startPos.x * (1 - eased);
                zoomedGroup.position.y = zoomState.startPos.y * (1 - eased);
                zoomedGroup.scale.setScalar(1 + (curScaleY - 1));
            }

            zoomRenderer.render(zoomScene, zoomCamera);

            if (t >= 1.0) finishZoom();
        }

        function finishZoom() {
            const href = zoomState.href;
            zoomState.active = false;
            zoomedGroup = null;
            navigate(href);
        }

        function renderPageTrack() {
            const track = document.getElementById('page-track')!;
            track.innerHTML = pages.map((pageChannels, p) => `
                 <div class="channel-grid channel-page" data-page="${p}"
                     style="grid-template-columns:repeat(${channelLayout.cols}, 1fr); grid-template-rows:repeat(${channelLayout.rows}, 1fr);">
                     ${pageChannels.map((ch: any) => cellMarkup(ch)).join('')}
                 </div>
             `).join('');
            pageEls = Array.from(track.querySelectorAll('.channel-page'));
        }

        function layoutPageTrack(offset?: number) {
            const w = container.clientWidth;
            const resolvedOffset = offset ?? channelLayout.page * w * 0.9;
            document.querySelectorAll('#page-track .channel-page').forEach((el) => {
                const p = Number((el as HTMLElement).dataset.page);
                (el as HTMLElement).style.transform = `translateX(${p * w * 0.9 - resolvedOffset}px)`;
            });
        }

        function easeInOutQuad(t: number) {
            return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
        }

        function animate(t: number) {
            animFrameId = requestAnimationFrame(animate);

            const w = container.clientWidth;
            let offset = channelLayout.page * w * 0.9;

            if (flipState.active) {
                const raw = Math.min((t - flipState.start) / flipState.duration, 1);
                offset = flipState.from + (flipState.to - flipState.from) * easeInOutQuad(raw);
                if (raw >= 1) {
                    flipState.active = false;
                    channelLayout.page = pendingPage;
                    updateArrows();
                }
            }

            // off set of moddels
            cellGroups.forEach((page, p) => {
                page.forEach((group, i) => {
                    if (i >= channelLayout.cpp) return;
                    if (zoomState.active && p === zoomState.pageIndex && i === zoomState.cellIndex) return; // stepZoom owns this one's position
                    const col = i % channelLayout.cols;
                    const padX = w * 0.05;
                    const cellW = (w - padX * 2) / channelLayout.cols;
                    group.position.x = p * w * 0.9 + padX + (col + 0.5) * cellW - w / 2 - offset;
                });
            });
            layoutPageTrack(offset);

            // idel animation (rotation and such of models)
            const s = t * 0.0005;
            cellGroups.forEach((page, p) => page.forEach((group, i) => {
                const ch = pages[p][i];
                group.children.forEach(child => {
                    if (child.userData.isBackground) return;
                    child.rotation.y = ch?.model.baseRotation?.[1] + 4 + (s + .00001 * t * ch?.model?.salt) * ch?.model?.direction;
                    child.rotation.x = ch?.model.baseRotation?.[0] + Math.cos(ch?.model?.salt * s * ch?.model?.animatedRotation?.[0]) / 5 + .2;
                    child.position.y = ch?.model?.baseRotation?.[2] + Math.cos(t * ch?.model?.saltBounce * .002) * 6;
                });
            }));

            if (zoomState.active) {
                stepZoom(t);
            }

            renderer.render(scene, camera);
        }
    });
</script>