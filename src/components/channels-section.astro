---
import '../styles/channel.css';
import '../styles/animations.css';
import '../styles/global.css'
import '../styles/arrows.css';
import overrides from '../data/channels-with-order.json';
import LoadingScreen from './loading-screen.astro';
import EmbeddedChannel from './embedded-channel.astro';
import LeftArrow from '../../public/svg/left-arrow.svg';

const globbed = import.meta.glob('../pages/articles/*.md', { eager: true });

function getRandomDirection() {
    return Math.random() < 0.5 ? -1 : 1;
}

const channels = Object.entries(globbed)
.map(([filepath, mod]: [string, any]) => {
    const slug = filepath.split('/').pop()!.replace(/\.md$/, '');
    const overrideIndex = (overrides as any[]).findIndex(o => o.slug === slug);
    const override = (overrides as any[]).find(o => o.slug === slug);

    if (!override) return null;
    return {
        order: overrideIndex,
        title:   mod.frontmatter.title,
        url:     `/articles/${slug}`,
        scanDir: override.model?.baseDir ?? mod.frontmatter.channelPageScanDir,
        animationSvg: override.animationSvgDir ? override.animationSvgDir : `/svg/mask-star.svg`,
        animationSvgDimentions: override.animationSvgDimentions ? override.animationSvgDimentions : [90.45, 43.61], // default to size of mask-star.svg. this could have its own json with options if i get around to making more default svgs
        imgPaths: override.imgPaths ? override.imgPaths : [],
        model:   { 
            position: override.model?.position ?? [0,0,0], 
            baseRotation: override.model?.baseRotation ?? [0,5,0],
            color: override.color ?? [250,250,250],
            animatedRotation: override.model?.animatedRotation ?? [1,1,0], 
            scale: override.model?.scale ?? 1,
            direction: override.model?.direction ?? getRandomDirection(),
            salt: Math.random(), 
            saltBounce: Math.random()
        }, 
    };
})
.filter(Boolean)
.sort((a, b) => a.order - b.order);

const channelsJson = JSON.stringify(channels);

---

{channels.map((ch) => {
  const slug = ch.url?.split('/').pop();
  return (
    <template data-slug={slug}>
      <EmbeddedChannel
        title={ch.title}
      />
    </template>
  );
})}

<LoadingScreen/> 

<div id="zoom-clone-layer"></div>
<div id="zoom-background"></div>

<div class="top-container">
  <canvas id="three-canvas" data-channels={channelsJson} style="pointer-events: none;"></canvas>
  <canvas id="zoom-canvas"></canvas>
  <div id="page-track" class="page-track"></div>
  <button id="arrow-prev" class="page-arrow left">
    <LeftArrow />
  </button>
  <button id="arrow-next" class="page-arrow right">
    <LeftArrow />
  </button>
</div>

<script >        
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { DRACOLoader } from 'three/examples/jsm/loaders/DRACOLoader.js';
    import { navigate } from 'astro:transitions/client';

    type FlipState = {
        active: Boolean,
        from: number,
        to: number,
        start: number,
        duration: number
    }

    type channelLayout = {
        page: number,
        cols: number,
        rows: number,
        cpp: number
    }

    type ZoomDir = 'in' | 'out';

    type ZoomState = {
        active: boolean,
        dir: ZoomDir,
        start: number,              // -1 until the first frame renders, so a janky load doesn't eat the animation
        pageIndex: number,
        cellIndex: number,
        cellRect: DOMRect,          // the cell's rect in viewport px (p = 0)
        viewW: number,              // the frame is laid out at this real pixel size (p = 1)
        viewH: number,
        href: string,
        anchorEl: HTMLElement | null,
        frameEl: HTMLElement | null,
        chromeEl: HTMLElement | null, 
        blackEl: HTMLElement | null,  // #zoom-background
        group: THREE.Group | null,    // the cell's model group
        warm: number,                 // frames to wait, with nothing visibly moving, before the clock may start
        hold: number,                 // ms to sit on the first pose once the clock starts (zoom out)
        committed: boolean,           // the real cell is hidden and the model has moved to the zoom stage
        restPos: THREE.Vector3,     // model endpoints: sitting in the cell (p = 0)
        fullPos: THREE.Vector3,     // ...and full screen (p = 1)
        restScale: number,
        fullScale: number
    }

    type Skips = {
        page: number | null,
        index: number | null,
    }

    // load the compressed 3d objects
    const dracoLoader = new DRACOLoader();
    dracoLoader.setDecoderPath('https://www.gstatic.com/draco/versioned/decoders/1.5.6/');
    const gltfLoader = new GLTFLoader();
    gltfLoader.setDRACOLoader(dracoLoader);

    declare global {
        interface Window {
            __modelCache: Map<string, THREE.Group>;
        }
    }
    
    window.__modelCache = window.__modelCache ?? new Map();
    
    const MIN_MS_OF_LOADING_SCREEEN = 500;
    const ZOOM_DURATION = 600; //ms

    const BLACK_FULL_AT = 0.5;
    const PAGE_FADE_FROM = 0.5;
    const PAGE_FADE_TO = 1;

    // mobile smoothness.
    // the zoom waits WARM_FRAMES rendered frames before anything moves, so shader compiles, texture uploads and the
    // first paint of the frame land while nothing is animating. zoom out then holds on its first pose (it looks like
    // the page you just left) for ZOOM_OUT_HOLD_MS before it starts shrinking
    const WARM_FRAMES = 3;
    const ZOOM_OUT_HOLD_MS = 50;
    // both webgl canvases are full screen + antialiased, and phones are 3x. cap it (set to 3 to undo)
    const MAX_PIXEL_RATIO = 2;

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const clamp01 = (v: number) => Math.min(Math.max(v, 0), 1);

    let pageEls: HTMLElement[] = [];
    let animFrameId: number;

    document.addEventListener('astro:page-load', () => {
        const canvas = document.getElementById('three-canvas') as HTMLCanvasElement;
        if (!canvas) return;

        let flipState: FlipState = {
            active: false,
            from: 0,
            to: 1,
            start: 0,
            duration: 600 // ms
        };

        let channelLayout: channelLayout = {
            page: 0,
            cols: 4,
            rows: 3,
            cpp: 12 
        };

        const container = canvas.parentElement!;
        const allChannels = JSON.parse(canvas.dataset.channels ?? '[]');
        const overlay = document.getElementById('loading-overlay');
        let pages = buildPages(channelLayout.cpp, allChannels);
        let pendingPage = 0;

        const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
        renderer.setPixelRatio(Math.min(devicePixelRatio, MAX_PIXEL_RATIO));

        const scene = new THREE.Scene();

        const w0 = container.clientWidth;
        const h0 = container.clientHeight;
        const camera = new THREE.OrthographicCamera(-w0/2, w0/2, h0/2, -h0/2, 0.1, 1000);
        camera.position.set(0, 0, 200);
        camera.lookAt(0, 0, 0);
        renderer.setSize(w0, h0);
        scene.add(camera);

        const ambient = new THREE.AmbientLight(0xffffff, 3);
        scene.add(ambient);
        const directionalLight = new THREE.DirectionalLight(0xffffff, 1.0);
        directionalLight.position.set(0, 10, 10);
        scene.add(directionalLight);

        // --- zoom stage: transparent on top and spanning below
        const zoomCanvas = document.getElementById('zoom-canvas') as HTMLCanvasElement;
        const zoomCloneLayer = document.getElementById('zoom-clone-layer') as HTMLElement;
        const zoomRenderer = new THREE.WebGLRenderer({ canvas: zoomCanvas, antialias: true, alpha: true });
        zoomRenderer.setPixelRatio(Math.min(devicePixelRatio, MAX_PIXEL_RATIO));
        const zoomScene = new THREE.Scene();
        const zoomCamera = new THREE.OrthographicCamera(-w0/2, w0/2, h0/2, -h0/2, 0.1, 1000);
        zoomCamera.position.set(0, 0, 200);
        zoomCamera.lookAt(0, 0, 0);
        zoomRenderer.setSize(w0, h0);
        zoomScene.add(zoomCamera);
        zoomScene.add(new THREE.AmbientLight(0xffffff, 3));
        const zoomDirLight = new THREE.DirectionalLight(0xffffff, 1.0);
        zoomDirLight.position.set(0, 10, 10);
        zoomScene.add(zoomDirLight);

        // in case we navigated back here mid-fade from a previous zoom
        setBackgroundOpacity(1);
        zoomCanvas.style.display = 'none';

        let zoomedGroup: THREE.Group | null = null;
        let zoomState: ZoomState = {
            active: false,
            dir: 'in',
            start: -1,
            pageIndex: 0,
            cellIndex: 0,
            cellRect: new DOMRect(),
            viewW: 0,
            viewH: 0,
            href: '',
            anchorEl: null,
            frameEl: null,
            chromeEl: null,
            blackEl: null,
            group: null,
            warm: 0,
            hold: 0,
            committed: false,
            restPos: new THREE.Vector3(),
            fullPos: new THREE.Vector3(),
            restScale: 1,
            fullScale: 1
        };

        const cellGroups: THREE.Group[][] = [];

        for (let p = 0; p < 2; p++) { // min of 2 pages, fill with blanks
            const page: THREE.Group[] = [];
            for (let i = 0; i < channelLayout.cols * channelLayout.rows; i++) {
                const g = new THREE.Group();
                scene.add(g);
                page.push(g);
            }
            cellGroups.push(page);
        }

        switchLayout(true);
        setup();

        const skips: Skips = startZoomOrLoading(); // shows either the loading screen if first load, shows the zooming if it is a redirect, returns index of preloaded or nulls
        loadchannels(skips);
        updateArrows();

        animFrameId = requestAnimationFrame(animate);

        window.addEventListener('resize', () => {
            switchLayout();
            setup();

            const w = container.clientWidth;
            const h = container.clientHeight;
            zoomRenderer.setSize(w, h);
            zoomCamera.left = -w / 2;
            zoomCamera.right = w / 2;
            zoomCamera.top = h / 2;
            zoomCamera.bottom = -h / 2;
            zoomCamera.updateProjectionMatrix();
        });

        document.getElementById('arrow-prev')?.addEventListener('click', () => startFlip(channelLayout.page - 1));
        document.getElementById('arrow-next')?.addEventListener('click', () => startFlip(channelLayout.page + 1));

        document.getElementById('page-track')?.addEventListener('click', (e) => {
            const anchor = (e.target as HTMLElement).closest('.channel-cell') as HTMLAnchorElement | null;
            if (!anchor || anchor.classList.contains('is-default-color')) return;

            const pageEl = anchor.closest('.channel-page') as HTMLElement | null;
            if (!pageEl) return;

            const pageIndex = Number(pageEl.dataset.page);
            const cellIndex = Array.from(pageEl.querySelectorAll('.channel-cell')).indexOf(anchor);
            const ch = pages[pageIndex]?.[cellIndex];
            if (!ch?.url) return;

            e.preventDefault();
            startZoomIn(pageIndex, cellIndex, anchor, anchor.href);
        });

        function startZoomOrLoading() {
            const params = new URLSearchParams(location.search);
            let skips: Skips = { page: null, index: null };

            if ( params.has('fromIndex') ) { // this came from somewhere else (routing), meaning we can zoom out working
                // fromIndex is the channel's global index in allChannels. map it through the CURRENT layout,
                // so the page is still right if the screen was rotated between leaving and coming back
                const index = Number(params.get('fromIndex'));

                if (Number.isInteger(index)) {
                    document.getElementById('loading-overlay')?.remove();

                    if ( index >= 0 ) { // message board is index -1
                        const page = Math.floor(index / channelLayout.cpp);
                        const cell = index % channelLayout.cpp;

                        if (startZoomOut(page, cell)) {
                            skips = { page, index: cell }; // startZoomOut already loaded this one
                        }
                    }
                }
            }
            history.replaceState(history.state, '', location.pathname + location.hash)

            return skips;
        }

        function buildPages(cpp: number, chs: any[]) {
            const padded = [
                ...chs,
                ...Array.from({ length: Math.max(0, 2 * cpp - chs.length) }, () => ({ // fill rest of page + whole next page with blank
                    title: 'static',
                    model: {
                        color: [9,9,9],
                        salt: Math.random(),
                        saltBounce: Math.random()
                    }
                }))
            ];
            return Array.from({ length: Math.ceil(padded.length / cpp) }, (_, i) =>
                padded.slice(i * cpp, (i + 1) * cpp)
            );
        }

        function setup() {
            const w = container.clientWidth;
            const h = container.clientHeight;
            renderer.setSize(w, h);

            camera.left   = -w / 2;
            camera.right  =  w / 2;
            camera.top    =  h / 2;
            camera.bottom = -h / 2;
            camera.updateProjectionMatrix();

            const padX = w * 0.05;
            const usableW = w - padX * 2;
            const cellW = usableW / channelLayout.cols;
            const cellH = h / channelLayout.rows;

            cellGroups.forEach((page, p) => {
                page.forEach((group, i) => {
                    if (i >= channelLayout.cpp) {
                        group.position.set(-99999, -99999, 0);
                        return;
                    }
                    const col = i % channelLayout.cols;
                    const row = Math.floor(i / channelLayout.cols);
                    group.position.set(
                        p * w * 0.9 + padX + (col + 0.5) * cellW - w / 2 - channelLayout.page * w * 0.9,
                        h / 2 - (row + 0.5) * cellH,
                        0
                    );
                    scaleGroup(p, i);
                });
            });
            renderPageTrack();
            layoutPageTrack();
        }

        function scaleGroup(pageIndex: number, cellIndex: number) {
            const group = cellGroups[pageIndex][cellIndex];
            const ch = pages[pageIndex][cellIndex];
            const w = container.clientWidth;
            const h = container.clientHeight;
            const padX = w * 0.05;
            const usableW = w - padX * 2;
            const cellW = usableW / channelLayout.cols;
            const cellH = h / channelLayout.rows;
            const cellSize = Math.min(cellW, cellH);

            group.children.forEach(child => {
                if (child.userData.isBackground) return;
                if (!ch) return;

                child.scale.set(1,1,1);

                const box = new THREE.Box3().setFromObject(child);
                const size = new THREE.Vector3();
                box.getSize(size);
                const longest = Math.max(size.x, size.y, size.z);
                if (longest > 0 && isFinite(longest)) {
                    child.scale.setScalar((cellSize * 0.55 * ch.model.scale) / longest);
                }
            });

            const outlinePx = 3;
            const cardGap = 25; 

            group.children.forEach(child => {
                if (!child.userData.isBackground) return;
                const shrink = child.userData.isOutline ? cardGap : cardGap + outlinePx * 3;
                child.scale.set(
                    (cellW - shrink) / 50,
                    (cellH - shrink) / 50,  
                    1
                );
            });
        }

        function mulberry32(seed: number) {
            let state = Math.floor(seed * 0xFFFFFFFF) >>> 0;

            return function () {
                state = (state + 0x6D2B79F5) | 0;
                let t = state;
                t = Math.imul(t ^ (t >>> 15), t | 1);
                t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
                return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
        }

        function buildNoiseAnimation(salt: number) {
            const rand = mulberry32(salt);

            const animation = `noise_shift_${salt.toString(36).replace(/\./g, "_")}`;

            const frames = 120; 
            const range = 100;       // ±px movement

            const keyframes = [];

            for (let i = 0; i <= frames; i++) {
                const pct = (i / frames) * 100;

                const x = Math.round((rand() * 2 - 1) * range / 2);
                const y = Math.round((rand() * 2 - 1) * range);

                keyframes.push(`${pct}%{transform:translate(${x}px,${y}px);}`);
                keyframes.push(`${pct - (1 / frames) * 100 + .00001}%{transform:translate(${x}px,${y}px);}`);
                
            }

            return `
                <style>
                @keyframes ${animation}{
                ${keyframes.join("")}
                }
                </style>

                <div class="little-logo">
                    GGO
                </div>

                <div
                    class="static-noise"
                    style="animation: ${animation} linear 15s infinite;">
                </div>
                
                `;
        }

        // experimenting with different timing from the salt, not 100% sold atm. maybe if i can get some ts that reads the size of the images and uses that to have
        function buildChannelSection( salt: number, title: string, animationSvg: string, svgDimentions: number[] | undefined, imgPaths: string[] ) {
            const slug = title.replaceAll(/[^a-zA-Z0-9\-._~]/g, "_"); // all url un safe chars
            const highlightedTitle = `
                        <div class="channel-name" style="-webkit-text-stroke-width: 8px; -webkit-text-stroke-color: black;">
                            ${title}
                        </div>
                        <div class="channel-name">
                            ${title}
                        </div>`;

            // no images, fall back to the drifting background svg
            if (imgPaths.length === 0) {
                const dims = svgDimentions ?? [1, 1];
                const aspectRatio = dims[0] / dims[1];
                const offSetYTimes = Math.trunc(aspectRatio);

                return `<style>
                            @keyframes drift_${slug} {
                                0% { transform: translate(0, 0); }
                                100% { transform: translate(${aspectRatio * 2.5}dvh, ${2.5 * offSetYTimes}dvh); }
                            }
                        </style>
                        <div class="grid-mover" 
                            style="background-image: url('${animationSvg}'); animation: drift_${slug} ${4 + salt}s linear infinite;"
                        >
                        </div>` + highlightedTitle;
            }

            // images present crossfade slideshow
            const perImageDuration = 4 + salt;
            const totalDuration = perImageDuration * imgPaths.length;
            const slot = 100 / imgPaths.length;
            const fadeEdge = slot * 0.15;

            const layers = imgPaths.map((path, i) => {
                const delay = -(i * perImageDuration);  // negative delay pre-offsets each image into its own slot
                return `<img
                            src="${path}"
                            class="fade-layer"
                            style="animation: fade_${slug} ${totalDuration}s ease-in-out infinite; animation-delay: ${delay}s;"
                        />`;
            }).join("");

            return `<style>
                        @keyframes fade_${slug} {
                            0% { opacity: 1; }
                            ${slot - fadeEdge}% { opacity: 1; }
                            ${slot}% { opacity: 0; }
                            ${100 - fadeEdge}% { opacity: 0; }
                            100% { opacity: 1; }
                        }
                        .fade-stack {
                            position: relative;
                            width: 100%;
                            height: 100%;
                        }
                        .fade-layer {
                            position: absolute;
                            inset: 0;
                            width: 100%;
                            height: 100%;
                            object-fit: cover;
                            opacity: 0;
                        }
                    </style>
                    <div class="fade-stack">
                        ${layers}
                    </div>` + highlightedTitle;
        }

        // note: the embedded channel no longer lives in every cell. the zoom builds one full-size frame
        // from the <template> on demand (see makeZoomFrame)
        function cellMarkup(ch: any) {
            const isDefaultColor = ch.model.color.every((v: number, i: number) => v === [9, 9, 9][i]);

            return `
                <a class="channel-cell${isDefaultColor ? ' is-default-color' : ''}" href="${ch.url || '#'}" ${isDefaultColor ? `style="pointer-events: none;"` : ''}>
                    <svg viewBox="0 0 50 50" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
                        <path
                            d="M 1 3
                            Q 0 25 1 47
                            Q 1.0417 48.9583 3 49
                            Q 25 50 47 49
                            Q 48.9583 48.9583 49 47
                            Q 50 25 49 3
                            Q 48.9583 1.0417 47 1
                            Q 25 0 3 1
                            Q 1.0417 1.0417 1 3
                            Z"
                            fill="rgb(${ch.model.color[0]}, ${ch.model.color[1]}, ${ch.model.color[2]})"
                            stroke="none"
                        />
                    </svg>
                    <div class="grid-wrap">

                    ${isDefaultColor
                        ? buildNoiseAnimation(ch.model.salt)
                        : buildChannelSection(ch.model.salt, ch.title, ch.animationSvg, ch.animationSvgDimentions, ch.imgPaths )
                    }

                    </div>

                    <svg viewBox="0 0 50 50" preserveAspectRatio="none" width="100%" height="100%">
                        <defs>
                            <mask id="mask01">
                                <rect width="100" height="100" fill="white"/>
                                <path
                                    d="M 1 3
                                    Q 0 25 1 47
                                    Q 1.0417 48.9583 3 49
                                    Q 25 50 47 49
                                    Q 48.9583 48.9583 49 47
                                    Q 50 25 49 3
                                    Q 48.9583 1.0417 47 1
                                    Q 25 0 3 1
                                    Q 1.0417 1.0417 1 3
                                    Z"
                                    fill="black"
                                />
                            </mask>
                        </defs>
                        <g mask="url(#mask01)">
                            <path fill="var(--wii-background)" fill-opacity="1"
                            d="M -100 -100
                            L200 -100
                            L200 100
                            L-100 100
                            Z" /> 
                        </g>
                        <path
                            class="cell-outline"
                            d="M 1 3
                            Q 0 25 1 47
                            Q 1.0417 48.9583 3 49
                            Q 25 50 47 49
                            Q 48.9583 48.9583 49 47
                            Q 50 25 49 3
                            Q 48.9583 1.0417 47 1
                            Q 25 0 3 1
                            Q 1.0417 1.0417 1 3
                            Z"
                            fill="none"
                            stroke="#afafaf"
                            stroke-width=".8"
                        />
                    </svg>
                </a>
            `;
        }

        function updateArrows() {
            const prev = document.getElementById('arrow-prev') as HTMLButtonElement;
            const next = document.getElementById('arrow-next') as HTMLButtonElement;
            prev.style.visibility = channelLayout.page === 0 ? 'hidden' : 'visible';
            next.style.visibility = channelLayout.page >= pages.length - 1 ? 'hidden' : 'visible';
        }

        function teardownModels() {
            cellGroups.forEach(page => {
                page.forEach(group => {
                    while (group.children.length > 0) {
                        const child = group.children[0];
                        group.remove(child);
                        if (child instanceof THREE.Mesh) {
                            child.geometry.dispose();
                            if (Array.isArray(child.material)) {
                                child.material.forEach((m: THREE.Material) => m.dispose());
                            } else {
                                (child.material as THREE.Material).dispose();
                            }
                        }
                    }
                });
            });
        }

        function switchLayout(initial : boolean = false) { // only have to account for the cols changing. not the rows
            const ratio = container.clientHeight / container.clientWidth;
            const newCols = ratio > 1 ? 2 : 4;
            const newCpp = newCols * channelLayout.rows;

            if ( newCols === channelLayout.cols ) return;

            const firstChannelIndex = channelLayout.page * channelLayout.cpp;

            channelLayout.cols = newCols;
            channelLayout.cpp = newCpp;

            pages = buildPages(channelLayout.cpp, allChannels);
            channelLayout.page = Math.floor(firstChannelIndex / channelLayout.cpp);

            if (!initial) {
                teardownModels();
                loadchannels();
            }
        }

        // this function changes the baked lighting of an obj. it is only used for the mii, and this will be removed come animations
        function applyFillLight(root: THREE.Object3D, boost = 2.0) {
            root.traverse((child) => {
                const mesh = child as THREE.Mesh;
                if (!mesh.isMesh) return;
                const mats = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
                mats.forEach((mat: any) => {
                    // only flat-Kd materials (hair/pants/shirt/skin/beard) need this correction.
                    if (mat.map) return;
                    if (mat.color) mat.color.multiplyScalar(boost); // scales diffuse reflectance, not a flat overlay
                    if (mat.emissive) {
                        const peak = Math.max(mat.color.r, mat.color.g, mat.color.b, 1e-4);
                        mat.emissive.copy(mat.color).multiplyScalar(0.01 / peak);
                    }
                });
            });
        }

        function loadchannels(skips : Skips = {page: null, index: null}) {
            const minWait = new Promise(resolve => setTimeout(resolve, MIN_MS_OF_LOADING_SCREEEN));
            
            for (let p = 0; p < cellGroups.length; p++) {
                for (let i = 0; i < channelLayout.cpp; i++) {
                    // only load if not already loaded by zooming. skip that ONE cell, not its whole page and column
                    if (!(skips.page === p && skips.index === i)) loadchannel(p, i);
                }
            }

            // render all channels + unload loading screen
            Promise.all([minWait]).then(() => {
                if (overlay) {
                    overlay.style.opacity = '.5';
                    overlay.style.animation = "fade_${slug} $.5s linear;"
                    setTimeout(() => overlay.remove(), MIN_MS_OF_LOADING_SCREEEN);
                }
                renderer.compile(scene, camera);
            });
        }

        function loadchannel(pageIndex: number, cellIndex: number) {
            const ch = pages[pageIndex]?.[cellIndex];
            if (!ch) return;

            const cacheKey = ch.scanDir;

            if (window.__modelCache.has(cacheKey)) { // cached
                const cached = window.__modelCache.get(cacheKey)!.clone();
                cached.position.set(...ch.model.position);
                cellGroups[pageIndex][cellIndex].add(cached);
                scaleGroup(pageIndex, cellIndex);
                return;
            }

            if (!ch?.scanDir) { // no model? no need to load a model.
                return;
            }

            const dir = ch.scanDir.replace(/\/$/, '');
            const glbPath = `${dir}.glb`;

            gltfLoader.load(
                glbPath,
                (gltf) => {
                    const root = gltf.scene;
                    root.position.set(...ch.model.position);

                    if (ch.title === 'About Me' || ch.title === 'About Mii') { // temp, remove come animations
                        applyFillLight(root);
                    }

                    cellGroups[pageIndex][cellIndex].add(root);
                    scaleGroup(pageIndex, cellIndex);
                    window.__modelCache.set(cacheKey, root.clone());
                },
                undefined,
                (err) => console.warn(`GLB load failed [${ch.title}]:`, err)
            );
        }

        function startFlip(targetPage: number) {
            if (flipState.active || zoomState.active || targetPage < 0 || targetPage >= pages.length) return;
            const w = container.clientWidth;
            flipState = { active: true, from: channelLayout.page * w * 0.9, to: targetPage * w * 0.9, start: performance.now(), duration: 600 };
            pendingPage = targetPage;
        }

        function backgroundLayers(): HTMLElement[] {
            return [
                canvas,
                document.getElementById('page-track'),
                document.getElementById('arrow-prev'),
                document.getElementById('arrow-next'),
                document.getElementById('bottom-container')
            ].filter(Boolean) as HTMLElement[];
        }

        function setBackgroundOpacity(value: number) {
            backgroundLayers().forEach(el => { el.style.opacity = `${value}`; });
        }

        // a cell group's resting x. shared by animate() and the zoom endpoints so they can't drift apart
        function cellWorldX(pageIndex: number, cellIndex: number, offset: number) {
            const w = container.clientWidth;
            const col = cellIndex % channelLayout.cols;
            const padX = w * 0.05;
            const cellW = (w - padX * 2) / channelLayout.cols;
            return pageIndex * w * 0.9 + padX + (col + 0.5) * cellW - w / 2 - offset;
        }

        function makeZoomFrame(slug?: string): HTMLElement {
            const frame = document.createElement('div');
            Object.assign(frame.style, {
                position: 'fixed',
                top: '0',
                left: '0',
                width: `${window.innerWidth}px`,   // real pixel size, laid out once
                height: `${window.innerHeight}px`,
                transformOrigin: '0 0',            // top left, so translate = where the corner lands
                transform: 'translate(0px, 0px) scale(1, 1)', // first paint is at scale 1, so it gets rastered at full resolution
                opacity: '0.01',                   // not 0: a fully transparent layer may never get painted at all
                willChange: 'transform, opacity',  // own layer. the zoom is then the compositor scaling a finished bitmap, no repaint per frame
                pointerEvents: 'none',
                overflow: 'hidden'
            });

            const tpl = slug ? document.querySelector<HTMLTemplateElement>(`template[data-slug="${slug}"]`) : null;
            if (tpl) frame.appendChild(tpl.content.cloneNode(true));

            // the frame carries the fade now, so the page inside is simply on
            const page = frame.querySelector('.embedded-channel') as HTMLElement | null;
            if (page) page.style.opacity = '1';

            return frame;
        }

        function makeChromeLayer(anchorEl: HTMLElement, rect: DOMRect): HTMLElement {
            const vw = window.innerWidth, vh = window.innerHeight;

            const layer = document.createElement('div');
            Object.assign(layer.style, {
                position: 'fixed', top: '0', left: '0',
                width: `${vw}px`, height: `${vh}px`,
                transformOrigin: '0 0',
                transform: 'translate(0px, 0px) scale(1, 1)', // rastered at full res, like the frame
                opacity: '0.01',                              // painted but invisible until renderZoom runs
                willChange: 'transform, opacity',
                pointerEvents: 'none', overflow: 'hidden'
            });

            // the whole cell: yellow svg, .grid-wrap (drifting pattern, names), top mask + outline
            const clone = anchorEl.cloneNode(true) as HTMLElement;
            clone.removeAttribute('href');
            Object.assign(clone.style, {
                position: 'absolute', top: '0', left: '0', margin: '0',
                width: `${rect.width}px`, height: `${rect.height}px`,
                transformOrigin: '0 0',
                transform: `scale(${vw / rect.width}, ${vh / rect.height})`,
                visibility: 'visible'
            });

            // the frame carries the sub page, so hide (don't remove) the cell's copy.
            // hiding keeps the element order identical to the original, which syncAnimations relies on
            const embedded = clone.querySelector<HTMLElement>('.embedded-channel');
            if (embedded) embedded.style.display = 'none';

            layer.append(clone);
            return layer;
        }

        function syncAnimations(from: Element, to: Element) {
            const a = [from, ...from.querySelectorAll('*')];
            const b = [to, ...to.querySelectorAll('*')];
            a.forEach((el, i) => {
                const twin = b[i];
                if (!twin) return;
                const dst = twin.getAnimations();
                el.getAnimations().forEach(src => {
                    if (!(src instanceof CSSAnimation)) return;
                    const match = dst.find(d => d instanceof CSSAnimation && d.animationName === src.animationName);
                    if (match) match.currentTime = src.currentTime;
                });
            });
        }

        function placeBehindModels(chrome: HTMLElement) {
            const main = renderer.domElement;
            const z = parseInt(getComputedStyle(main).zIndex, 10);
            chrome.style.zIndex = Number.isNaN(z) ? '0' : String(z - 1);
            main.parentElement!.insertBefore(chrome, main);
        }

        function beginZoom(dir: ZoomDir, pageIndex: number, cellIndex: number, anchorEl: HTMLElement, href = '') {
            if (flipState.active || zoomState.active) return;

            const rect = anchorEl.getBoundingClientRect();
            const vw = window.innerWidth;
            const vh = window.innerHeight;
            const slug = pages[pageIndex]?.[cellIndex]?.url?.split('/').pop();

            // the frame is the only thing that zooms. there is deliberately no copy of the cell left behind
            const frame = makeZoomFrame(slug);  
            const chrome = makeChromeLayer(anchorEl, rect);
            zoomCloneLayer.innerHTML = '';
            zoomCloneLayer.append(frame);
            placeBehindModels(chrome);

            const blackEl = document.getElementById('zoom-background') as HTMLElement | null;

            // the canvas has to be displayed before we can measure it
            zoomCanvas.style.display = 'block';

            // model endpoints. rest = in the cell, full = centered on the viewport.
            // world units are css px, so the full position comes from where the zoom canvas
            // actually sits on screen rather than assuming world (0, 0) is the viewport's center
            const group = cellGroups[pageIndex]?.[cellIndex] ?? null;
            const offset = channelLayout.page * container.clientWidth * 0.9;
            const cr = zoomCanvas.getBoundingClientRect();

            const restPos = new THREE.Vector3(
                cellWorldX(pageIndex, cellIndex, offset),
                group?.position.y ?? 0,
                group?.position.z ?? 0
            );
            const fullPos = new THREE.Vector3(
                vw / 2 - (cr.left + cr.width / 2),
                (cr.top + cr.height / 2) - vh / 2,
                restPos.z
            );
            const restScale = group?.scale.x ?? 1;
            const fullScale = restScale * (vh / rect.height);

            zoomState = {
                active: true,
                dir,
                start: -1,
                warm: WARM_FRAMES,
                hold: dir === 'out' ? ZOOM_OUT_HOLD_MS : 0,
                committed: false,
                pageIndex,
                cellIndex,
                cellRect: rect,
                viewW: vw,
                viewH: vh,
                href,
                anchorEl,
                frameEl: frame,
                blackEl,
                chromeEl: chrome,
                group,
                restPos,
                fullPos,
                restScale,
                fullScale
            };

            if (dir === 'out') {
                commitZoom();
                renderZoom(1);
            }
        }

        // the real cell goes away and the model moves to the zoom stage
        function commitZoom() {
            const z = zoomState;
            z.committed = true;

            if (z.anchorEl) z.anchorEl.style.visibility = 'hidden';
            if (z.group) zoomScene.add(z.group); // moves it out of the main scene
            zoomedGroup = z.group;

            // own layers while we fade them, so each frame doesn't repaint the whole grid
            backgroundLayers().forEach(el => { el.style.willChange = 'opacity'; });
        }

        function startZoomIn(pageIndex: number, cellIndex: number, anchorEl: HTMLAnchorElement, href: string) {
            beginZoom('in', pageIndex, cellIndex, anchorEl, href);
        }

        // page + cell are already resolved from fromIndex (see startZoomOrLoading). returns false if there's nothing to zoom to
        function startZoomOut(page: number, cell: number): boolean {
            const slug = pages[page]?.[cell]?.url?.split('/').pop();
            if (!slug) return false;

            // park the track on the destination page BEFORE measuring the cell. snap, don't flip
            channelLayout.page = page;
            layoutPageTrack(page * container.clientWidth * 0.9);
            updateArrows();

            const anchor = document
                .querySelector(`.channel-page[data-page="${page}"]`)
                ?.querySelectorAll<HTMLAnchorElement>('.channel-cell')[cell];
            if (!anchor) return false;

            // synchronous when the model is cached. otherwise it pops in when it arrives, into the zoomed group
            if (cellGroups[page]?.[cell]) loadchannel(page, cell);

            beginZoom('out', page, cell, anchor);
            return true;
        }

        function renderZoom(p: number) {
            const z = zoomState;
            const r = z.cellRect;

            // timeline (constants up top): grid -> black, then black -> sub page
            const dark = clamp01(p / BLACK_FULL_AT);
            const page = clamp01((p - PAGE_FADE_FROM) / (PAGE_FADE_TO - PAGE_FADE_FROM));
            const transformation = `translate(${lerp(r.left, 0, p)}px, ${lerp(r.top, 0, p)}px) ` +
                `scale(${lerp(r.width / z.viewW, 1, p)}, ${lerp(r.height / z.viewH, 1, p)})`

            setBackgroundOpacity(1 - dark); // cells, images, other models, arrows
            if (z.blackEl) z.blackEl.style.opacity = `${dark}`;

            if (z.dir === 'out' && z.anchorEl) z.anchorEl.style.visibility = p <= BLACK_FULL_AT ? '' : 'hidden';

            if (z.frameEl) {
                // floor of 0.01 keeps the layer alive and painted while it's "invisible"
                z.frameEl.style.opacity = `${Math.max(page, 0.01)}`;

                // frame: cell rect -> viewport, on the same clock as the model
                z.frameEl.style.transform = transformation;
            }

            if (z.chromeEl) {
                z.chromeEl.style.transform = transformation;

                z.chromeEl.style.opacity = `${1 - page}`;
            }

            if (zoomedGroup) {
                zoomedGroup.position.x = lerp(z.restPos.x, z.fullPos.x, p);
                zoomedGroup.position.y = lerp(z.restPos.y, z.fullPos.y, p);
                zoomedGroup.scale.setScalar(lerp(z.restScale, z.fullScale, p));
            }

            zoomRenderer.render(zoomScene, zoomCamera);
        }

        function stepZoom(now: number) {
            const z = zoomState;

            if (z.warm > 0) {
                z.warm--;
                if (z.warm === 0 && !z.committed) { // zoom in: only now does the real cell vanish
                    commitZoom();
                    renderZoom(0);
                }
                return;
            }

            if (z.start < 0) z.start = now + z.hold; // clock starts after the stalls, plus the hold on zoom out

            const t = clamp01((now - z.start) / ZOOM_DURATION);
            renderZoom(z.dir === 'in' ? t : 1 - t);

            if (t >= 1) finishZoom();
        }

        function finishZoom() {
            const z = zoomState;
            z.active = false;

            if (z.dir === 'in') {
                zoomedGroup = null;
                navigate(z.href);
                return;
            }

            // zoom out: hand the model back to the normal scene and put everything back the way it was
            if (zoomedGroup) {
                zoomedGroup.position.copy(z.restPos);
                zoomedGroup.scale.setScalar(z.restScale);
                scene.add(zoomedGroup);
            }
            zoomedGroup = null;

            if (z.anchorEl) z.anchorEl.style.visibility = '';
            setBackgroundOpacity(1);
            backgroundLayers().forEach(el => { el.style.willChange = ''; });
            if (z.blackEl) z.blackEl.style.opacity = '0';
            if (z.chromeEl) { 
                z.chromeEl.style.opacity = '0';
                z.chromeEl.style.zIndex = '-1';
            }
            zoomCloneLayer.innerHTML = '';
            zoomCanvas.style.display = 'none';
        }

        function renderPageTrack() {
            const track = document.getElementById('page-track')!;
            track.innerHTML = pages.map((pageChannels, p) => `
                 <div class="channel-grid channel-page" data-page="${p}"
                     style="grid-template-columns:repeat(${channelLayout.cols}, 1fr); grid-template-rows:repeat(${channelLayout.rows}, 1fr);">
                     ${pageChannels.map((ch: any) => cellMarkup(ch)).join('')}
                 </div>
             `).join('');
            pageEls = Array.from(track.querySelectorAll('.channel-page'));
        }

        function layoutPageTrack(offset?: number) {
            const w = container.clientWidth;
            const resolvedOffset = offset ?? channelLayout.page * w * 0.9;
            document.querySelectorAll('#page-track .channel-page').forEach((el) => {
                const p = Number((el as HTMLElement).dataset.page);
                (el as HTMLElement).style.transform = `translateX(${p * w * 0.9 - resolvedOffset}px)`;
            });
        }

        function easeInOutQuad(t: number) {
            return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
        }

        function animate(t: number) {
            animFrameId = requestAnimationFrame(animate);

            const w = container.clientWidth;
            let offset = channelLayout.page * w * 0.9;

            if (flipState.active) {
                const raw = Math.min((t - flipState.start) / flipState.duration, 1);
                offset = flipState.from + (flipState.to - flipState.from) * easeInOutQuad(raw);
                if (raw >= 1) {
                    flipState.active = false;
                    channelLayout.page = pendingPage;
                    updateArrows();
                }
            }

            // off set of moddels
            cellGroups.forEach((page, p) => {
                page.forEach((group, i) => {
                    if (i >= channelLayout.cpp) return;
                    if (zoomState.active && p === zoomState.pageIndex && i === zoomState.cellIndex) return; // renderZoom owns this one's position
                    group.position.x = cellWorldX(p, i, offset);
                });
            });
            layoutPageTrack(offset);

            // idel animation (rotation and such of models)
            const s = t * 0.0005;
            cellGroups.forEach((page, p) => page.forEach((group, i) => {
                const ch = pages[p][i];
                group.children.forEach(child => {
                    if (child.userData.isBackground) return;
                    child.rotation.y = ch?.model.baseRotation?.[1] + 4 + (s + .00001 * t * ch?.model?.salt) * ch?.model?.direction;
                    child.rotation.x = ch?.model.baseRotation?.[0] + Math.cos(ch?.model?.salt * s * ch?.model?.animatedRotation?.[0]) / 5 + .2;
                    child.position.y = ch?.model?.baseRotation?.[2] + Math.cos(t * ch?.model?.saltBounce * .002) * 6;
                });
            }));

            if (zoomState.active) {
                stepZoom(t);
            }

            renderer.render(scene, camera);
        }
    });
</script>