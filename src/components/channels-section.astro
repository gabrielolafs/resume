---
import '../styles/channel.css';
import overrides from '../data/channels-with-order.json';

const globbed = import.meta.glob('../pages/articles/*.md', { eager: true });

const channels = Object.entries(globbed)
.map(([filepath, mod]: [string, any]) => {
    const slug = filepath.split('/').pop()!.replace(/\.md$/, '');
    const override = (overrides as any[]).find(o => o.slug === slug);
    if (!override) return null; // not in json, skip it
    return {
        title:   mod.frontmatter.title,
        url:     `/articles/${slug}`,
        scanDir: mod.frontmatter.channelPageScanDir,
        order:   override.order ?? 999,
        model:   override.model ?? { position: [0,0,0], rotation: [0,0,0], scale: 1 },
    };
})
.filter(Boolean) // remove nulls
.sort((a, b) => a.order - b.order)
.slice(0, 12);


// Pad to always have 12 entries — extras get the placeholder in loadModel
const padded = [
...channels,
...Array.from({ length: Math.max(0, 12 - channels.length) }, () => ({
    title:   'beer',
    url:     '',
    scanDir: '/scans/beer2',
    order:   999,
    model:   { position: [0,0,0] as [number,number,number], rotation: [0,0,0] as [number,number,number], scale: 1 },
})),
];

const channelsJson = JSON.stringify(padded);
---

<div class="top-container">
  <canvas id="three-canvas" data-channels={channelsJson}></canvas>
  <div class="channel-grid">
    {padded.map((ch) => (
      <a class="channel-cell" href={ch.url || '#'}>
        {ch.title && <span>{ch.title}</span>}
      </a>
    ))}
  </div>
</div>

<script>
    import * as THREE from 'three';
    import { OBJLoader } from 'three/addons/loaders/OBJLoader.js';
    import { MTLLoader } from 'three/addons/loaders/MTLLoader.js';

    const BASE_NAME = 'mesh_lowpoly';
    const cols = 4, rows = 3;

    const canvas    = document.getElementById('three-canvas') as HTMLCanvasElement;
    const container = canvas.parentElement!;
    const channels  = JSON.parse(canvas.dataset.channels ?? '[]') as {
        title:   string;
        url:     string;
        scanDir: string;
        model:   { position: [number,number,number]; rotation: [number,number,number]; scale: number };
    }[];

    const renderer = new THREE.WebGLRenderer({ canvas, antialias: true });
    renderer.setPixelRatio(devicePixelRatio);

    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xE7E7E7);

    // camera
    const w0 = container.clientWidth;
    const h0 = container.clientHeight;
    const camera = new THREE.OrthographicCamera(-w0/2, w0/2, h0/2, -h0/2, 0.1, 1000);
    camera.position.set(0, 0, 200);
    camera.lookAt(0, 0, 0);
    renderer.setSize(w0, h0);
    scene.add(camera);

    // lighting

    const ambient = new THREE.AmbientLight(0xffffff, 4);
    scene.add(ambient);

    const sun = new THREE.DirectionalLight(0xffffff, 1);
    sun.position.set(0, 0, 1); 
    scene.add(sun); 

    // const hemi = new THREE.HemisphereLight(0xffffff, 0x000000, 5.5);
    // scene.add(hemi);

    const cellGroups: THREE.Group[] = [];
    for (let i = 0; i < cols * rows; i++) {
        const g = new THREE.Group();
        scene.add(g);
        cellGroups.push(g);
    }

    function addBackground(index: number, colorArr?: [number, number, number]) {
        const [r, g, b] = colorArr ?? [250, 250, 250];
        const color = new THREE.Color(r / 255, g / 255, b / 255);

        const shape = new THREE.Shape();
        shape.moveTo(1, 3);
        shape.quadraticCurveTo(0, 25, 1, 47);
        shape.quadraticCurveTo(1.0417, 48.9583, 3, 49);
        shape.quadraticCurveTo(25, 50, 47, 49);
        shape.quadraticCurveTo(48.9583, 48.9583, 49, 47);
        shape.quadraticCurveTo(50, 25, 49, 3);
        shape.quadraticCurveTo(48.9583, 1.0417, 47, 1);
        shape.quadraticCurveTo(25, 0, 3, 1);
        shape.quadraticCurveTo(1.0417, 1.0417, 1, 3);

        const geo = new THREE.ShapeGeometry(shape);

        // Center it — shape is in 0..50 space, center at 25,25
        geo.translate(-25, -25, 0);

        const mat = new THREE.MeshBasicMaterial({ color, side: THREE.DoubleSide });
        const mesh = new THREE.Mesh(geo, mat);

        // Push it behind the model
        mesh.position.z = -50;
        mesh.userData.isBackground = true;

        cellGroups[index].add(mesh);
    }

    function setup() {
        const w = container.clientWidth;
        const h = container.clientHeight;
        renderer.setSize(w, h);

        camera.left   = -w / 2;
        camera.right  =  w / 2;
        camera.top    =  h / 2;
        camera.bottom = -h / 2;
        camera.updateProjectionMatrix();

        const cellW    = w / cols;
        const cellH    = h / rows;
        const cellSize = Math.min(cellW, cellH);

        cellGroups.forEach((group, i) => {
            const col = i % cols;
            const row = Math.floor(i / cols);
            group.position.set(
                (col + 0.5) * cellW - w / 2,
                h / 2 - (row + 0.5) * cellH,
                0
            );

            scaleGroup(i);

        });
    }

    function scaleGroup(index: number) {
        const group = cellGroups[index];
        const ch = channels[index];
        const w = container.clientWidth;
        const h = container.clientHeight;
        const cellW = w / cols;
        const cellH = h / rows;
        const cellSize = Math.min(cellW, cellH);

        group.children.forEach(child => {
            if (child.userData.isBackground) return;
            if (!ch) return;

            child.scale.set(1,1,1);

            const box = new THREE.Box3().setFromObject(child);
            const size = new THREE.Vector3();
            box.getSize(size);
            const longest = Math.max(size.x, size.y, size.z);
            if (longest > 0 && isFinite(longest)) {
                child.scale.setScalar((cellSize * 0.55 * ch.model.scale) / longest);
            }
        });

        const backgrounds = group.children.find(c => c.userData.isBackground);
        if (backgrounds) {
            backgrounds.scale.set(cellW / 50, cellH / 100, 1);
        }
    }

    setup();

    function loadModel(index: number) {
        const ch = channels[index];
        addBackground(index, ch?.model?.color);

        console.log(ch);

        if (!ch?.scanDir) { // catches if there is no model
            console.log('there is no mo');
            const geo = new THREE.IcosahedronGeometry(1, 0);
            const mat = new THREE.MeshPhongMaterial({ color: 0xcccccc, flatShading: true });
            const mesh = new THREE.Mesh(geo, mat);
            cellGroups[index].add(mesh);
            scaleGroup(index);
            return;
        }

        const dir     = ch.scanDir.replace(/\/$/, '');
        const mtlPath = `${dir}/${BASE_NAME}.mtl`;
        const objPath = `${dir}/${BASE_NAME}.obj`;
        const texPath = `${dir}/`;

        const mtlLoader = new MTLLoader();
        mtlLoader.setResourcePath(texPath);
        mtlLoader.load(
            mtlPath,
            (materials: any) => {
            materials.preload();
            const objLoader = new OBJLoader();
            objLoader.setMaterials(materials);
            objLoader.load(
                objPath,
                (obj: THREE.Group) => {
                obj.position.set(...ch.model.position);
                obj.rotation.set(...ch.model.rotation);
                cellGroups[index].add(obj);
                scaleGroup(index);
                },
                undefined,
                (err: any) => console.warn(`OBJ load failed [${ch.title}]:`, err)
            );
            },
            undefined,
            (err: any) => console.warn(`MTL load failed [${ch.title}]:`, err)
        );
        }

    // replace channels.forEach with this
    for (let i = 0; i < cols * rows; i++) {
        loadModel(i);
    }

    function animate(t: number) {
        requestAnimationFrame(animate);
        const s = t * 0.001;
        cellGroups.forEach((group, i) => {
            group.children.forEach(child => {
                if (child.userData.isBackground) return; // dont rotate the background
                child.rotation.y = s * (0.5 + i * 0.03);
            });
        });
        renderer.render(scene, camera);
    }

    requestAnimationFrame(animate);
    window.addEventListener('resize', setup);
</script>