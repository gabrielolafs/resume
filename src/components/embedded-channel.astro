---
import '../styles/articles.css';
import FocusedBottomBar from '../components/focused-bottom-bar.astro';

const { title, dateWritten, timeSpan, tech, index = -1 } = Astro.props;
---
<style>
  .embedded-channel {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    z-index: 1;
    background-color: var(--wii-background);
    opacity: 0;

    box-sizing: border-box; /* needed so the padding doesn't overflow the 100% size */
    padding: 5% 5% 0 5%;
  }

  .mini-vignette {
    position: absolute;
    height: 100%;
    width: 100%;
    inset: 0;
    pointer-events: none;
  }
</style>

<div class="embedded-channel">
  <div class="top">
      <div class="title">
        <h1>{title}</h1>
      </div>
      <div class="timeline">
        {dateWritten && <p><b>Written:</b> {dateWritten}</p>}
        {timeSpan && <p><b>Active:</b> {timeSpan}</p>}
      </div>
      <div class="tech-stack">
        {tech && tech.map((tech : String) => (
          <div class="tech">{tech}</div>
        ))}
      </div>
    </div>

  <FocusedBottomBar fromIndex={index} />

  <div class="mini-vignette">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="100%" height="100%" preserveAspectRatio="none">
      <filter id="blurMe">
        <feGaussianBlur in="SourceGraphic" stdDeviation=".3" />
      </filter>
      <path filter="url(#blurMe)"
        fill="none" stroke="black" stroke-width="4"
        d="M-1 3 Q-2 25 -1 47 Q-0.9583 50.9583 3 51 Q25 52 47 51 Q50.9583 50.9583 51 47 Q52 25 51 3 Q50.9583 -0.9583 47 -1 Q25 -2 3 -1 Q-0.9583 -0.9583 -1 3 Z"
      />
    </svg>
  </div>
</div>