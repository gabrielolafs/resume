---
import '../styles/articles.css';
---
<style>
  .embedded-channel {
    position: absolute;
    width: 100%;
    height: 100%;
    inset: 0;
    z-index: 1;
    background-color: var(--wii-background);
    /* background-color: black; */
    opacity: 0;
  }

  .embedded-channel .coloring {
    height: 20%;
  }

  .waiste-space {
    height: 80%;
  }

  .mini-vignette {
    position: absolute;
    height: 100%;
    width: 100%;
    inset: 0;
  }
</style>

<div class="embedded-channel">
  
  <div class="waiste-space"></div>  
  <div class="coloring">
      <svg xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" overflow="visible" viewBox="0 0 24 24">
          <path fill="var(--background-color)" stroke="var(--wii-blue-darker)" stroke-width=".3" d="M-1 1 Q12 0 25 1 L25 25 L-1 25 Z"></path>
      </svg>
  </div>
  <div class="mini-vignette">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 50" width="100%" height="100%" preserveAspectRatio="none">
      <filter id="blurMe">
        <feGaussianBlur in="SourceGraphic" stdDeviation=".3" />
      </filter>
      <path filter="url(#blurMe)"
        fill="none" stroke="black" stroke-width="4"
        d="M-1 3 Q-2 25 -1 47 Q-0.9583 50.9583 3 51 Q25 52 47 51 Q50.9583 50.9583 51 47 Q52 25 51 3 Q50.9583 -0.9583 47 -1 Q25 -2 3 -1 Q-0.9583 -0.9583 -1 3 Z"
      />
    </svg>
  </div>
  
  

  <!-- <div class="buttons">
      <WiiButton href="/">Home</WiiButton>
      <WiiButton onclick="window.toggleCrt()">Toggle CRT</WiiButton>
  </div> -->
</div>

