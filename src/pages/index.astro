---
import * as article from './articles/article.md';
import Layout from '../layouts/articles.astro';

const posts = Object.values(import.meta.glob('./articles/*.md', { eager: true }));
---
<Layout title="Home Page">

    <p>{article.frontmatter.title}</p>
    <p>By: {article.frontmatter.author}</p>

    <div set:html={article.compiledContent()} />

    <p>Post Archive:</p>
    <ul>
        {posts.map(post => 
            <li>
                <a href={post.url}>
                    {post.frontmatter.title}
                </a>
            </li>
        )}
    </ul>

</Layout>