---
import * as article from './articles/primary.md';
import Layout from '../layouts/articles.astro';
import BottomBar from '../components/bottom-bar.astro';
import ChannelsSection from '../components/channels-section.astro';

import '../styles/index.css';
---

<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta property="og:title" content="Gabriel Olafsson's Website" />
    <meta property="og:description" content="Retro inpired portfolio / personal page" />
    <meta property="og:image" content="https://gabrielolafsson.dev/img/self_desktop_vp.png" />
    <meta property="og:url" content="https://gabrielolafsson.dev" />
    <meta property="og:type" content="website" /> 

    <meta name="image" content="https://gabrielolafsson.dev/img/self_desktop_vp.png" />

    <meta name="author" content="Gabriel Olafsson" />
    <meta property="article:author" content="Gabriel Olafsson" />
    <meta name="publish-date" content="2026-07-12" />
    <meta property="article:published_time" content="2026-07-08T08:02:28Z">
</head>
<div class="container">
    <div class="content">
        <Layout {...article} set:html={article.compiledContent()} />
    </div>
    
    <ChannelsSection />
    <BottomBar />
</div>
</html>