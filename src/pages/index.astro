---
import * as article from './articles/article.md';
import Layout from '../layouts/articles.astro';
import type { ACTION_ERROR_CODES } from 'astro:actions';
import '../styles/articles.css';

const posts = Object.values(import.meta.glob('./articles/*.md', { eager: true }));
---

<Layout {...article} set:html={article.compiledContent()} />

<p>Post Archive:</p>
<ul>
    {posts.map(post => 
        <li>
            <a href={post.url}>
                {post.frontmatter.title}
            </a>
        </li>
    )}
</ul>