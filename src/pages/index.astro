---
import * as wii from './articles/article.md';
const posts = Object.values(import.meta.glob('./articles/*.md', { eager: true }))
---

<p>{wii.frontmatter.title}</p>
<p>By: {wii.frontmatter.author}</p>

<div set:html={wii.compiledContent()} />

<p>Post Archive:</p>
<ul>
    {posts.map(post => <li><a href={post.url}>{post.frontmatter.title}</a></li>)}
</ul>